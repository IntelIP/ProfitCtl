{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IntelIP/ProfitCtl/schemas/upstash-reconciliation/v1/reconciliation.schema.json",
  "title": "ProfitCtl Upstash Reconciliation v1",
  "description": "Provider-free, synthetic Redis polling reconciliation artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "scenario_id",
    "source",
    "window",
    "workload",
    "forecast",
    "observed",
    "billing",
    "variance",
    "dominant_operational_driver",
    "limitations",
    "ledger_observation_id",
    "ledger_normalization"
  ],
  "properties": {
    "schema_version": {
      "const": "profitctl.upstash-reconciliation/v1"
    },
    "fixture_status": {
      "const": "synthetic"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "workload": {
      "type": "string",
      "minLength": 1
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polling_interval_seconds",
        "worker_replicas",
        "active_seconds",
        "commands_per_poll",
        "misses_per_poll",
        "polls_per_worker",
        "polling_events",
        "predicted_command_count",
        "predicted_miss_count",
        "unit_price",
        "predicted_cost"
      ],
      "properties": {
        "polling_interval_seconds": { "type": "integer", "minimum": 1 },
        "worker_replicas": { "type": "integer", "minimum": 1 },
        "active_seconds": { "type": "integer", "minimum": 1 },
        "commands_per_poll": { "type": "integer", "minimum": 1 },
        "misses_per_poll": { "type": "integer", "minimum": 0 },
        "polls_per_worker": { "type": "number", "minimum": 0 },
        "polling_events": { "type": "number", "minimum": 0 },
        "predicted_command_count": { "type": "number", "minimum": 0 },
        "predicted_miss_count": { "type": "number", "minimum": 0 },
        "unit_price": { "$ref": "#/$defs/unit_price" },
        "predicted_cost": { "$ref": "#/$defs/money" }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_count",
        "miss_count",
        "records_seen",
        "records_used",
        "duplicate_records_ignored",
        "derived_cost"
      ],
      "properties": {
        "command_count": { "type": "number", "minimum": 0 },
        "miss_count": { "type": "number", "minimum": 0 },
        "records_seen": { "type": "integer", "minimum": 0 },
        "records_used": { "type": "integer", "minimum": 0 },
        "duplicate_records_ignored": { "type": "integer", "minimum": 0 },
        "derived_cost": { "$ref": "#/$defs/money" }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_status"],
      "properties": {
        "evidence_status": { "enum": ["available", "unavailable"] },
        "total_cost": { "$ref": "#/$defs/money" },
        "window": { "$ref": "#/$defs/window" },
        "artifact_identity": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "#/$defs/capture_time" },
        "unavailable_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidence_status": { "const": "available" } },
            "required": ["evidence_status"]
          },
          "then": {
            "required": ["total_cost", "window", "artifact_identity", "captured_at"],
            "not": { "required": ["unavailable_reason"] }
          },
          "else": {
            "required": ["unavailable_reason"],
            "not": {
              "anyOf": [
                { "required": ["total_cost"] },
                { "required": ["window"] },
                { "required": ["artifact_identity"] },
                { "required": ["captured_at"] }
              ]
            }
          }
        }
      ]
    },
    "variance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_minus_predicted_commands", "observed_minus_predicted_cost"],
      "properties": {
        "observed_minus_predicted_commands": { "type": "number" },
        "observed_minus_predicted_cost": { "$ref": "#/$defs/signed_money" },
        "billed_minus_observed_cost": { "$ref": "#/$defs/signed_money" }
      }
    },
    "dominant_operational_driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "basis", "modeled_polling_events", "modeled_command_count"],
      "properties": {
        "classification": { "enum": ["idle_polling", "active_workload"] },
        "basis": { "const": "declared_fixture_input" },
        "modeled_polling_events": { "type": "number", "minimum": 0 },
        "modeled_command_count": { "type": "number", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ledger_observation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "ledger_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_id", "raw_source"],
      "properties": {
        "status": { "enum": ["ingested", "already_present"] },
        "observation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "raw_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_identity", "sha256"],
          "properties": {
            "artifact_identity": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_identity", "captured_at"],
      "properties": {
        "artifact_identity": { "type": "string", "minLength": 1 },
        "captured_at": { "$ref": "#/$defs/capture_time" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "signed_money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "capture_time": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "unit_price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "per"],
      "properties": {
        "amount": { "$ref": "#/$defs/money" },
        "per": { "$ref": "#/$defs/quantity" }
      }
    }
  }
}
