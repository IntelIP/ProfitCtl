{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IntelIP/ProfitCtl/schemas/cost-ledger/v1/ledger.schema.json",
  "title": "ProfitCtl Local Cost Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "drivers", "observations"],
  "properties": {
    "schema_version": { "const": "profitctl.ledger/v1" },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "../../cost-contract/v1/cost-driver.schema.json"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "raw_source"],
        "properties": {
          "observation": {
            "$ref": "../../cost-contract/v1/cost-observation.schema.json"
          },
          "raw_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_identity", "sha256"],
            "properties": {
              "artifact_identity": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
