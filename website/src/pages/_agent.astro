---
// Parked: the leading underscore keeps this page out of the built site. Rename to agent.astro to publish it again,
// then restore its links in ProductLayout.astro, DecisionHero.astro and scripts/check-seo.mjs.
import "@fontsource/instrument-sans/latin-500.css";
import "@fontsource/instrument-sans/latin-600.css";
import ProductLayout from "../layouts/ProductLayout.astro";
import cohort from "../../../examples/system/accepted-outcomes.json";
import { money } from "../scripts/demo";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const previewCommit = "a0bd725b29750702aae1fa79ecb39f9390b0b829";
const source = repoUrl + "/blob/" + previewCommit;
const checkout = [
  "git clone " + repoUrl + ".git",
  "cd ProfitCtl",
  "git checkout --detach " + previewCommit,
  "uv sync --frozen --project agent",
  "agent/.venv/bin/profitctl-agent --help",
].join("\n");
const [selective, every] = cohort.options;
const cost = (option: typeof selective) => option.costs.reduce((sum, charge) => sum + charge.usd, 0);
const baseline = cost(selective) / selective.accepted!;
const matchCount = Math.ceil(cost(every) / baseline);
const needed = Math.floor(cost(every) / baseline) + 1;
---

<ProductLayout title="ProfitCTL Agent | Investigate costs in Codex and Claude Code" description="Explore a saved cost investigation across Codex and Claude Code. Follow its evidence, reopen the checkpoint, and try the self-hosted ProfitCTL Agent from source." pageType="agent">
  <div class="site-shell agent-spread">
    <header class="agent-intro">
      <p class="agent-id">ProfitCTL Agent <span>v1.0.0 in development</span></p>
      <h1>Start in Codex.<br />Resume in Claude.</h1>
      <p class="intro-copy">Ask which product choice is worth its cost. ProfitCTL runs the numbers, saves the open question and picks up where you left off in Claude Code.</p>
      <div class="actions">
        <a class="primary" href="#case">Try the guided demo <span aria-hidden="true">↘</span></a>
        <a href="#self-host">Self-host the preview <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <section class="case-file" aria-labelledby="case-title" id="case" data-agent-demo data-attempts={selective.attempts} data-selective-cost={cost(selective)} data-every-cost={cost(every)} data-state="waiting">
      <header class="file-head">
        <p class="file-label">Guided demo <span>Sample case · no model is called</span></p>
        <h2 id="case-title">Should every assessment use deeper research?</h2>
        <p>Walk through one investigation the way the agent runs it. The numbers are illustrative and are calculated in your browser.</p>
      </header>

      <div class="stage">
        <p class="stage-title"><span>1</span>The agent prices what you do today</p>
        <div class="stage-content">
          <div class="demo-control">
            <div><label for="demo-selective">Selective assessments reviewers accepted</label><output for="demo-selective"><b data-selective-accepted>{selective.accepted}</b> of {selective.attempts}</output></div>
            <input id="demo-selective" type="range" min="1" max={selective.attempts} step="1" value={selective.accepted} />
          </div>
          <dl class="metrics">
            <div><dt>Selective research</dt><dd><span data-baseline>{money(baseline, 2)}</span><small> / accepted</small></dd></div>
            <div><dt>Research every request</dt><dd>{money(cost(every))}<small> / {every.attempts} attempts</small></dd></div>
          </dl>
          <p>It saves this as revision 1 and stops with one open question: how many would reviewers accept with deeper research? <span data-break-even>It needs at least {needed} of {every.attempts} to beat today’s cost.</span></p>
        </div>
      </div>

      <div class="stage">
        <p class="stage-title"><span>2</span>You answer when you have the evidence</p>
        <div class="stage-content">
          <p>The question waits on disk, so you can close the session and come back in another client.</p>
          <div class="demo-control">
            <div><label for="demo-every">Accepted with deeper research</label><output for="demo-every"><b data-every-accepted>{matchCount}</b> of {every.attempts}</output></div>
            <input id="demo-every" type="range" min="0" max={every.attempts} step="1" value={matchCount} />
          </div>
          <div class="demo-actions">
            <button type="button" class="demo-button" data-action="supply">Supply this answer</button>
            <button type="button" class="demo-button quiet" data-action="decline">Decline to answer</button>
          </div>
        </div>
      </div>

      <div class="stage">
        <p class="stage-title"><span>3</span>The agent records the decision</p>
        <div class="stage-content" role="status" aria-live="polite" aria-atomic="true">
          <p class="result-title" data-result-title>Waiting for your answer</p>
          <p data-result-detail>Revision 1 holds the baseline and the open question. Nothing changes until you answer or decline.</p>
          <button type="button" class="demo-reset" data-action="reset" hidden>Start over</button>
        </div>
      </div>
      <noscript><p class="stage-content">Enable JavaScript to change the numbers and answer the question.</p></noscript>
      <a class="fixture" href={source + "/examples/system/accepted-outcomes.json"}>Inspect the sample inputs <span aria-hidden="true">↗</span></a>
    </section>
  </div>

  <section class="setup" id="self-host">
    <div class="site-shell setup-grid">
      <div>
        <p class="file-label">Self-hosting</p>
        <h2>Run the agent in your own workspace.</h2>
        <p class="setup-lead">Try the MIT-licensed source preview on macOS or Linux with Git, uv, Python 3.12 or 3.13 and Go 1.26.8. The setup guide walks through your first local case and both client connections.</p>
        <a class="primary" href={source + "/docs/standalone-investigations.md"}>Open the setup guide <span aria-hidden="true">↗</span></a>
        <details class="source-command">
          <summary>Show the pinned source commands</summary>
          <pre><code>{checkout}</code></pre>
        </details>
      </div>
      <dl class="implementation">
        <div><dt>Connect both clients</dt><dd>Point Codex and Claude Code at the same private workspace over MCP. Use the run ID in either client to return to the case.</dd></div>
        <div><dt>Follow the calculation</dt><dd>LangChain’s Deep Agents SDK investigates the question. ProfitCTL’s Go calculator prices the options, and LangGraph saves the checkpoint in SQLite. A scripted rehearsal runs offline. Model-backed runs send case context to your configured provider and use its quota.</dd></div>
        <div><dt>Review a system design</dt><dd>Optional local hooks compare expected load, peak cost and break-even when you propose an architecture change. <a href={source + "/docs/design-reviews.md"}>Read the queue example <span aria-hidden="true">↗</span></a></dd></div>
        <div><dt>Planned after v1.0.0</dt><dd>The first release targets one operator using a local workspace. Shared team workspaces and collaborative decision reviews are on the roadmap.</dd></div>
      </dl>
    </div>
  </section>
</ProductLayout>

<script>
  import { money } from "../scripts/demo";

  // A guided walk-through of the agent's three steps. Everything is arithmetic on the sample case; no model or server is involved.
  const demo = document.querySelector<HTMLElement>("[data-agent-demo]");
  if (demo) {
    const attempts = Number(demo.dataset.attempts);
    const selectiveCost = Number(demo.dataset.selectiveCost);
    const everyCost = Number(demo.dataset.everyCost);
    const selective = demo.querySelector<HTMLInputElement>("#demo-selective")!;
    const every = demo.querySelector<HTMLInputElement>("#demo-every")!;
    const reset = demo.querySelector<HTMLButtonElement>("[data-action=reset]")!;
    const text = (selector: string, value: string) => { demo.querySelector<HTMLElement>(selector)!.textContent = value; };
    const price = (value: number) => money(value, Number.isInteger(value) ? 0 : 2);
    let state: "waiting" | "supplied" | "declined" = "waiting";

    function render() {
      const baseline = selectiveCost / selective.valueAsNumber;
      const needed = Math.floor(everyCost / baseline) + 1;
      const accepted = every.valueAsNumber;
      text("[data-selective-accepted]", String(selective.valueAsNumber));
      text("[data-every-accepted]", String(accepted));
      text("[data-baseline]", price(baseline));
      text("[data-break-even]", needed > attempts
        ? `Even ${attempts} of ${attempts} would not beat today’s cost.`
        : `It needs at least ${needed} of ${attempts} to beat today’s cost.`);
      demo!.dataset.state = state;
      reset.hidden = state === "waiting";
      if (state === "waiting") {
        text("[data-result-title]", "Waiting for your answer");
        text("[data-result-detail]", "Revision 1 holds the baseline and the open question. Nothing changes until you answer or decline.");
      } else if (state === "declined") {
        text("[data-result-title]", "Acceptance stays unknown");
        text("[data-result-detail]", "The agent records the decline and keeps revision 1. Selective research remains the baseline until someone measures the alternative.");
      } else if (accepted === 0) {
        text("[data-result-title]", "Selective research stays");
        text("[data-result-detail]", `With no accepted assessments, deeper research spends ${price(everyCost)} for nothing. Revision 2 records your answer and keeps selective research at ${price(baseline)} per accepted assessment.`);
      } else {
        const unit = everyCost / accepted;
        const gap = Math.abs(unit - baseline);
        if (gap < 0.005) {
          text("[data-result-title]", `Both cost ${price(unit)} per accepted assessment`);
          text("[data-result-detail]", "The options tie. Revision 2 records your answer; one more acceptance would tip the decision to deeper research.");
        } else if (unit < baseline) {
          text("[data-result-title]", `Deeper research wins at ${price(unit)} per accepted assessment`);
          text("[data-result-detail]", `That is ${price(gap)} less than selective research at ${price(baseline)}. Revision 2 records your answer and the new recommendation.`);
        } else {
          text("[data-result-title]", `Selective research stays at ${price(baseline)} per accepted assessment`);
          text("[data-result-detail]", `Deeper research would cost ${price(unit)}, which is ${price(gap)} more. Revision 2 records your answer and keeps the baseline.`);
        }
      }
    }
    selective.addEventListener("input", render);
    every.addEventListener("input", render);
    demo.querySelectorAll<HTMLButtonElement>("[data-action]").forEach(button => button.addEventListener("click", () => {
      state = button.dataset.action === "supply" ? "supplied" : button.dataset.action === "decline" ? "declined" : "waiting";
      render();
    }));
    render();
  }
</script>

<style>
  .agent-spread { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(34px, 5vw, 86px); align-items: start; padding-block: clamp(48px, 7vw, 110px); }
  .agent-id, .file-label { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 15px; color: var(--accent-ink); font-size: 14px; font-weight: 600; }
  .agent-id span, .file-label span { color: var(--muted); border-left: 1px solid var(--line-strong); padding-left: 15px; font-size: 13px; font-weight: 500; }
  h1 { margin-block: 20px 18px; font-size: var(--text-h1); font-weight: 600; line-height: 1.04; letter-spacing: -.03em; text-wrap: balance; }
  .intro-copy, .setup-lead { max-width: 46ch; color: var(--muted); font-size: var(--text-lede); line-height: 1.55; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 22px; margin-top: 26px; }
  .actions a, .primary, .fixture { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; font-weight: 600; }
  a { text-underline-offset: 4px; }
  .primary { min-height: 48px; padding: 0 24px; border-radius: 999px; background: light-dark(var(--icon-ink), var(--icon-sage)); color: light-dark(#f5f5ee, var(--icon-ink)); text-decoration: none; transition: background-color .15s ease; }
  .primary:hover { background: light-dark(#3a4136, #c3ccc4); }
  .case-file { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); scroll-margin-top: 100px; }
  .file-head, .stage-content { padding: 22px clamp(18px, 2.1vw, 30px); }
  .file-head { background: var(--tint); }
  .file-head h2 { font-size: var(--text-h3); font-weight: 600; letter-spacing: -.02em; line-height: 1.15; text-wrap: balance; }
  .setup h2 { font-size: var(--text-h2); font-weight: 550; letter-spacing: -.025em; line-height: 1.06; text-wrap: balance; }
  .file-head h2 { margin-block: 14px 10px; max-width: 19ch; }
  .file-head > p:last-child, .stage-content p, .implementation dd { color: var(--muted); font-size: var(--text-body); line-height: 1.55; text-wrap: pretty; }
  .stage { border-top: 1px solid var(--line); padding-block: 20px; }
  .stage-title { display: flex; align-items: center; gap: 12px; padding-inline: clamp(18px, 2.1vw, 30px); font-size: var(--text-body); font-weight: 600; }
  .stage-title span { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--tint); color: var(--muted); font: 600 13px/1 var(--font-mono); }
  .stage-content { padding-block: 12px 0; }
  .stage-content p + .demo-control { margin-top: 12px; }
  .demo-control > div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .demo-control label { color: var(--muted); font-size: var(--text-small); }
  .demo-control output { color: var(--muted); font-size: var(--text-small); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .demo-control output b { color: var(--ink); font-size: var(--text-h3); font-weight: 600; }
  .demo-control input { display: block; width: 100%; min-height: 44px; margin: 0; accent-color: var(--series-research); cursor: pointer; }
  .metrics { display: flex; flex-wrap: wrap; gap: 16px 32px; margin-block: 8px 12px; }
  .metrics dt { margin-bottom: 4px; color: var(--muted); font-size: var(--text-small); }
  .metrics dd { color: var(--ink); font-size: var(--text-h2); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .metrics small { color: var(--muted); font-size: var(--text-small); font-weight: 500; }
  .demo-actions { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-top: 8px; }
  .demo-button { min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px; background: light-dark(var(--icon-ink), var(--icon-sage)); color: light-dark(#f5f5ee, var(--icon-ink)); font-size: var(--text-body); font-weight: 600; transition: background-color .15s ease; }
  .demo-button:hover { background: light-dark(#3a4136, #c3ccc4); }
  .demo-button.quiet { border: 1px solid var(--line-strong); background: transparent; color: var(--ink); }
  .demo-button.quiet:hover { background: var(--tint); }
  .stage-content .result-title { color: var(--ink); font-size: var(--text-lede); font-weight: 600; margin-bottom: 6px; }
  [data-state="waiting"] .result-title { color: var(--muted); }
  .demo-reset { min-height: 44px; margin-top: 4px; padding: 0; border: 0; background: none; color: var(--accent-ink); font-size: var(--text-small); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .demo-reset[hidden] { display: none; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; color: var(--accent-ink); font-size: 20px; line-height: 1; }
  details[open] > summary::after { content: "−"; }
  .fixture { padding: 8px clamp(18px, 2.1vw, 30px); width: 100%; border-top: 1px solid var(--line); color: var(--accent-ink); font-size: 14px; }
  .setup { margin: 0 var(--band-inset) calc(var(--section-y) / 2); border-radius: var(--radius-lg); background: var(--tint); }
  .setup > .site-shell { width: min(1140px, calc(100% - 2 * (var(--gutter) - var(--band-inset)))); }
  .setup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 7vw, 106px); padding-block: clamp(44px, 6vw, 80px); }
  .setup h2 { margin-block: 15px; max-width: 17ch; }
  .setup .primary { margin-top: 24px; }
  .source-command { margin-top: 14px; }
  .source-command summary { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--accent-ink); font-size: 15px; font-weight: 600; }
  .source-command pre { margin: 5px 0 0; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); font-size: var(--text-small); line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
  .implementation > div { padding-block: 16px; border-top: 1px solid var(--line-strong); }
  .implementation dt { margin-bottom: 6px; font-size: 17px; font-weight: 600; }
  .implementation a { color: var(--accent-ink); }
  @media (max-width: 800px) {
    .agent-spread, .setup-grid { grid-template-columns: minmax(0, 1fr); }
    .agent-spread { padding-block: 40px; gap: 30px; }
    h1 { font-size: clamp(43px, 8.5vw, 68px); }
    .intro-copy { max-width: 48ch; }
  }
  @media (max-width: 420px) {
    h1 { margin-block: 17px; font-size: clamp(36px, 11vw, 43px); }
    .actions { gap: 4px 12px; font-size: 15px; }
  }
</style>
