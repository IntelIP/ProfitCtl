---
import ProductLayout from "../layouts/ProductLayout.astro";
---
<ProductLayout title="Page missing | ProfitCTL" description="Return to the ProfitCTL homepage or open the documentation." pageType="error">
  <section class="site-shell missing">
    <p>404</p>
    <h1>Page not found.</h1>
    <a href="/">Return to ProfitCTL</a>
  </section>
</ProductLayout>
<style>
  .missing { padding-block: clamp(60px, 12vw, 150px); }
  p { color: var(--accent-ink); font-variant-numeric: tabular-nums; }
  h1 { margin-block: 14px 24px; font-size: clamp(40px, 7vw, 84px); line-height: 1; letter-spacing: -.05em; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent-ink); text-underline-offset: 4px; }
</style>
