---
import ProductLayout from "../layouts/ProductLayout.astro";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const providers = [
  {
    name: "Cloudflare Workers",
    shortName: "Workers",
    logo: "/logos/profitctl/cloudflare-workers.svg",
    logoAlt: "Cloudflare Workers",
    fixed: "$24",
    variable: "$6.30",
    monthly: "$87",
    margin: "78%",
    p95: "62%",
    activeCost: "$9.40",
    delta: "best",
    state: "pass",
    stateLabel: "Pass",
    series: "workers",
  },
  {
    name: "Google Cloud Run",
    shortName: "Cloud Run",
    logo: "/logos/profitctl/google-cloud.svg",
    logoAlt: "Google Cloud",
    fixed: "$38",
    variable: "$8.10",
    monthly: "$128",
    margin: "66%",
    p95: "52%",
    activeCost: "$12.30",
    delta: "+47%",
    state: "pass",
    stateLabel: "Pass",
    series: "cloud",
  },
  {
    name: "Vercel",
    shortName: "Vercel",
    logo: "/logos/profitctl/vercel.svg",
    logoAlt: "Vercel",
    fixed: "$52",
    variable: "$11.40",
    monthly: "$162",
    margin: "58%",
    p95: "41%",
    activeCost: "$16.80",
    delta: "+86%",
    state: "watch",
    stateLabel: "Watch",
    series: "vercel",
  },
];

const heroMetrics = [
  { label: "Monthly cost", value: "$87", detail: "best option" },
  { label: "Gross margin", value: "78%", detail: "meets >= 60%" },
  { label: "p95 margin", value: "62%", detail: "meets >= 40%" },
  { label: "Cost / active user", value: "$9.40", detail: "meets <= $18" },
];

const deliveryModes = ["CLI today", "Codex skill", "CI output"];

const evidenceCards = [
  {
    badge: "Deploy choice",
    title: "Workers vs Vercel for this Next.js app",
    logos: [
      { src: "/logos/profitctl/cloudflare-workers.svg", alt: "Cloudflare Workers" },
      { src: "/logos/profitctl/vercel.svg", alt: "Vercel" },
    ],
    bars: [
      { label: "Workers", value: 31, amount: "$87", tone: "workers" },
      { label: "Cloud Run", value: 46, amount: "$128", tone: "cloud" },
      { label: "Vercel", value: 58, amount: "$162", tone: "vercel" },
    ],
    metrics: [
      { label: "Margin", value: "78%" },
      { label: "p95", value: "62%" },
      { label: "Cost / user", value: "$9.40" },
    ],
    action: "See comparison",
  },
  {
    badge: "Deep research risk",
    title: "What is the cost risk of adding deep research?",
    logos: [
      { src: "/logos/profitctl/openai.svg", alt: "OpenAI" },
      { src: "/logos/profitctl/google-cloud.svg", alt: "Google Cloud" },
    ],
    bars: [
      { label: "Base", value: 18, amount: "$9.40", tone: "neutral" },
      { label: "+ light research", value: 36, amount: "$17.80", tone: "cloud" },
      { label: "+ deep research", value: 52, amount: "$26.60", tone: "risk" },
    ],
    metrics: [
      { label: "Margin", value: "42%" },
      { label: "p95", value: "28%" },
      { label: "Cost / user", value: "$26.60" },
    ],
    action: "Run this scenario",
  },
  {
    badge: "Pricing model",
    title: "Which pricing model keeps 60%+ margin?",
    pricingRows: [
      { label: "Pro plan ($20/mo)", value: 78, tone: "workers" },
      { label: "Team plan ($40/mo)", value: 64, tone: "cloud" },
      { label: "Usage ($0.10 / msg)", value: 38, tone: "risk" },
    ],
    metrics: [
      { label: "Best option", value: "Pro plan" },
      { label: "ARR potential", value: "$2.4M" },
      { label: "Confidence", value: "Medium" },
    ],
    action: "Model your pricing",
  },
];

const standards = [
  { label: "Provenance", detail: "Every cost line has source, capture date, and note." },
  { label: "Confidence", detail: "Low, medium, high based on actual evidence, not guesswork." },
  { label: "Covenants", detail: "Margins, p95, and user cost tracked against explicit targets." },
  { label: "Decision artifact", detail: "Shareable output with assumptions, tables, and charts." },
  { label: "No hand-wave claims", detail: "Judge blocks precise claims without trustworthy evidence." },
];

const productSurfaces = [
  {
    status: "Open source now",
    title: "CLI",
    detail: "Run compare, simulate, and validate locally.",
    items: [
      "compare, simulate, validate",
      "Scenario templates",
      "Local modeling",
      "JSON output",
      "Standards judge",
    ],
  },
  {
    status: "Open source now",
    title: "Codex skill",
    detail: "Pull repo context into cost-aware agent decisions.",
    items: [
      "Repo-aware cost decisions",
      "Architecture comparisons",
      "Assumption-aware output",
      "Temporary scenario edits",
      "No new CLI command in v1",
    ],
  },
  {
    status: "Open source now",
    title: "CI / PR check",
    detail: "Turn scenarios into gates before spend lands.",
    items: [
      "JSON output in CI",
      "Recurring margin checks",
      "Covenant failures in PRs",
      "Saved scenario files",
      "Decision evidence in reviews",
    ],
  },
  {
    status: "Hosted later",
    title: "Team workflow",
    detail: "Keep history, approvals, and calibration in one place.",
    items: [
      "Team workspaces",
      "Saved runs and history",
      "Policies and approvals",
      "Calibration connectors",
      "RBAC and SSO",
    ],
  },
];

const footerLinks = [
  { label: "GitHub", href: repoUrl, external: true },
  { label: "Get started", href: "#get-started" },
];
---

<ProductLayout
  title="ProfitCtl | AI and SaaS Cost & Profitability CLI"
  description="ProfitCtl helps AI-native teams compare infrastructure, model, tool, pricing, and product-cost decisions before spend becomes real."
>
  <main class="profitctl-page">
    <header class="site-header">
      <div class="site-header-inner">
          <a href="/" class="brand" aria-label="ProfitCtl home">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>ProfitCtl</span>
        </a>
        <nav class="site-nav" aria-label="ProfitCtl navigation">
          <a href="#compare">Compare</a>
          <a href="#demos">Examples</a>
          <a href="#standards">Standards</a>
          <a href="#open-core">Open core</a>
        </nav>
        <a class="nav-button" href={repoUrl} rel="noopener noreferrer" target="_blank">
          <img src="/logos/profitctl/github.svg" alt="" loading="eager" decoding="async" />
          GitHub
        </a>
      </div>
    </header>

    <section class="hero-shell">
      <div class="hero-copy">
        <h1>Compare spend before it ships.</h1>
        <p>
          ProfitCtl helps AI-native teams compare infrastructure, model, API, and pricing
          choices with unit economics that hold under real usage.
        </p>

        <div class="hero-actions">
          <a class="primary-action" href={repoUrl} rel="noopener noreferrer" target="_blank">
            Try ProfitCtl locally
          </a>
          <a class="secondary-action" href="#demos">View examples</a>
        </div>

        <div class="entry-strip" aria-label="ProfitCtl delivery modes">
          <strong>Use it as</strong>
          <div>
            {deliveryModes.map((mode) => <span>{mode}</span>)}
          </div>
        </div>

        <div class="proof-points" aria-label="ProfitCtl proof points">
          <article>
            <span aria-hidden="true" />
            <strong>Open source</strong>
            <small>MIT licensed</small>
          </article>
          <article>
            <span aria-hidden="true" />
            <strong>Unit economics</strong>
            <small>Not vibes</small>
          </article>
          <article>
            <span aria-hidden="true" />
            <strong>Decision evidence</strong>
            <small>For teams and agents</small>
          </article>
        </div>
      </div>

      <article class="decision-board" id="compare" aria-label="ProfitCtl compare preview">
        <div class="command-strip">
          <span>$ profitctl compare baseline.yml candidate.yml</span>
          <strong>Illustrative example</strong>
        </div>

        <div class="metrics-strip">
          {
            heroMetrics.map((metric) => (
              <article>
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <small>{metric.detail}</small>
              </article>
            ))
          }
        </div>

        <div class="chart-shell">
          <div class="chart-header">
            <div>
              <p>Projected monthly cost</p>
              <h2>Based on 10k active users</h2>
            </div>
            <div class="chart-legend" aria-hidden="true">
              <span class="workers">Cloudflare Workers</span>
              <span class="cloud">Google Cloud Run</span>
              <span class="vercel">Vercel</span>
              <span class="threshold">Threshold</span>
            </div>
          </div>

          <svg
            class="compare-chart"
            viewBox="0 0 560 244"
            role="img"
            aria-label="Projected monthly cost comparison from May to October with covenant threshold"
          >
            <path class="axis-grid" d="M56 36H520 M56 72H520 M56 108H520 M56 144H520 M56 180H520" />
            <path class="axis-rule" d="M56 180V36 M56 180H520" />
            <path class="threshold-line" d="M56 90H520" />
            <text class="threshold-label" x="64" y="84">$150 threshold</text>

            <path class="workers-area" d="M56 180 L56 160 L149 156 L242 152 L334 148 L427 142 L520 136 L520 180 Z" />

            <polyline class="workers-line" points="56,160 149,156 242,152 334,148 427,142 520,136" />
            <polyline class="cloud-line" points="56,148 149,140 242,132 334,124 427,116 520,108" />
            <polyline class="vercel-line" points="56,136 149,122 242,114 334,98 427,84 520,68" />

            <circle class="workers-point" cx="427" cy="142" r="6" />
            <circle class="cloud-point" cx="427" cy="116" r="5" />
            <circle class="vercel-point" cx="427" cy="84" r="5" />
            <path class="active-guide" d="M427 180V56" />
            <text class="active-label" x="427" y="48">$87</text>

            <text class="axis-label" x="44" y="40">$200</text>
            <text class="axis-label" x="44" y="76">$160</text>
            <text class="axis-label" x="44" y="112">$120</text>
            <text class="axis-label" x="44" y="148">$80</text>
            <text class="axis-label" x="44" y="184">$0</text>

            <text class="month-label" x="56" y="212">May</text>
            <text class="month-label" x="149" y="212">Jun</text>
            <text class="month-label" x="242" y="212">Jul</text>
            <text class="month-label" x="334" y="212">Aug</text>
            <text class="month-label" x="427" y="212">Sep</text>
            <text class="month-label" x="520" y="212">Oct</text>
          </svg>
        </div>

        <div class="provider-summary" aria-label="Compare provider summary">
          {
            providers.map((provider) => (
              <article class={`summary-card ${provider.series}`}>
                <div class="summary-id">
                  <img src={provider.logo} alt={provider.logoAlt} loading="eager" decoding="async" />
                  <div>
                    <h3>{provider.shortName}</h3>
                    <p>{provider.stateLabel}</p>
                  </div>
                </div>
                <strong>{provider.monthly}</strong>
                <small>{provider.margin} gross margin</small>
              </article>
            ))
          }
        </div>

        <div class="recommendation-bar">
          <div class="recommendation-copy">
            <strong>Workers clears every covenant.</strong>
            <p>Save $75 / month vs Vercel at 10k active users.</p>
          </div>
          <a href="#demos">View examples</a>
        </div>
      </article>
    </section>

    <section class="evidence-band" id="demos" aria-label="ProfitCtl decision examples">
      {
        evidenceCards.map((card) => (
          <article class="evidence-card">
            <span class="card-badge">{card.badge}</span>
            <h2>{card.title}</h2>

            {
              card.logos && (
                <div class="card-logos">
                  {card.logos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />)}
                </div>
              )
            }

            {
              card.bars && (
                <div class="mini-chart">
                  {card.bars.map((bar) => (
                    <div class={`mini-row ${bar.tone}`}>
                      <span>{bar.label}</span>
                      <div class="mini-track">
                        <i style={`--mini-width:${bar.value}%`} />
                      </div>
                      <strong>{bar.amount}</strong>
                    </div>
                  ))}
                  <div class="mini-axis" aria-hidden="true">
                    <span>$0</span>
                    <span>$100</span>
                    <span>$200</span>
                    <span>$300</span>
                  </div>
                </div>
              )
            }

            {
              card.pricingRows && (
                <div class="mini-chart pricing-chart">
                  {card.pricingRows.map((row) => (
                    <div class={`mini-row ${row.tone}`}>
                      <span>{row.label}</span>
                      <div class="mini-track">
                        <i style={`--mini-width:${row.value}%`} />
                      </div>
                      <strong>{row.value}%</strong>
                    </div>
                  ))}
                  <div class="mini-axis" aria-hidden="true">
                    <span>0%</span>
                    <span>50%</span>
                    <span>100%</span>
                  </div>
                </div>
              )
            }

            <dl class="card-metrics">
              {card.metrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>

            <a href="#compare">{card.action}</a>
          </article>
        ))
      }
    </section>

    <section class="standards-section" id="standards">
      <div class="section-copy">
        <h2>Standards make the math trustworthy.</h2>
        <p>Every answer includes provenance, confidence, assumptions, and covenant checks.</p>
      </div>

      <div class="standards-grid">
        {
          standards.map((standard) => (
            <article>
              <span class="standard-icon" aria-hidden="true" />
              <h3>{standard.label}</h3>
              <p>{standard.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="open-core-section" id="open-core">
      <div class="section-copy">
        <h2>ProfitCtl ships today as a CLI, a Codex skill, and a CI check.</h2>
        <p>
          Same scenario engine, different delivery surface. Open source covers local compare,
          repo-aware agent decisions, and PR gates now. Hosted workflow later adds saved history,
          approvals, and calibration.
        </p>
      </div>

      <div class="core-map">
        {
          productSurfaces.map((surface) => (
            <article class={`surface-card ${surface.status === "Hosted later" ? "later" : "current"}`}>
              <span class="side-label">{surface.status}</span>
              <h3>{surface.title}</h3>
              <p>{surface.detail}</p>
              <ul>
                {surface.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="final-cta" id="get-started">
      <div>
        <span class="section-chip">First step</span>
        <h2>Run one compare from the CLI.</h2>
        <p>
          Start with one local scenario and one real choice. Keep the output as your decision
          artifact. Add the Codex skill or CI gate after the workflow proves useful.
        </p>
      </div>
      <div class="cta-actions">
        <a href={repoUrl} rel="noopener noreferrer" target="_blank">
          Open GitHub
        </a>
        <a class="cta-secondary" href="#compare">See compare output</a>
      </div>
    </section>

    <footer class="product-footer">
      <div class="product-footer-inner">
        <a href="/" class="brand" aria-label="ProfitCtl home">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>ProfitCtl</span>
        </a>
        <nav aria-label="ProfitCtl footer">
          {
            footerLinks.map((link) => (
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined} target={link.external ? "_blank" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <p>Copyright (c) 2026 ProfitCtl contributors.</p>
      </div>
    </footer>
  </main>
</ProductLayout>

<style>
  :global(html) {
    background: hsl(42 38% 95%);
    color-scheme: light;
  }

  .profitctl-page {
    --pc-bg: 42 38% 95%;
    --pc-bg-2: 34 34% 98%;
    --pc-panel: 0 0% 100%;
    --pc-panel-2: 40 38% 97%;
    --pc-panel-3: 45 26% 92%;
    --pc-line: 38 18% 83%;
    --pc-line-strong: 34 18% 74%;
    --pc-text: 30 14% 11%;
    --pc-muted: 28 10% 38%;
    --pc-subtle: 30 10% 56%;
    --pc-profit: 84 83% 47%;
    --pc-profit-deep: 83 72% 34%;
    --pc-copper: 32 77% 56%;
    --pc-risk: 22 90% 58%;
    --pc-blue: 217 63% 55%;
    --pc-shadow: 30 18% 30%;
    min-height: 100vh;
    overflow-x: clip;
    background:
      radial-gradient(circle at top left, hsl(var(--pc-profit) / 0.14), transparent 24rem),
      radial-gradient(circle at 90% 16%, hsl(var(--pc-copper) / 0.12), transparent 28rem),
      linear-gradient(180deg, hsl(var(--pc-bg-2)) 0%, hsl(var(--pc-bg)) 52%, hsl(40 30% 93%) 100%);
    color: hsl(var(--pc-text));
  }

  .profitctl-page :is(h1, h2, h3, p, dl, dd) {
    margin: 0;
  }

  .profitctl-page :is(section, article, div) {
    min-width: 0;
  }

  .profitctl-page a:focus-visible {
    outline: 3px solid hsl(var(--pc-profit-deep));
    outline-offset: 4px;
  }

  .hero-shell,
  .site-header-inner,
  .product-footer-inner,
  .evidence-band,
  .standards-section,
  .open-core-section,
  .final-cta {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 74px;
    border-bottom: 1px solid hsl(var(--pc-line) / 0.95);
    background: hsl(var(--pc-bg-2) / 0.86);
    backdrop-filter: blur(18px);
    width: 100%;
    padding-inline: 0;
  }

  .site-header-inner,
  .product-footer-inner {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    height: 100%;
  }

  .brand,
  .site-nav,
  .nav-button,
  .hero-actions,
  .product-footer,
  .product-footer nav,
  .card-logos {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 12px;
    color: hsl(var(--pc-text));
    font-size: 18px;
    font-weight: 760;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 8px;
    background: hsl(var(--pc-profit) / 0.22);
    color: hsl(var(--pc-profit-deep));
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
  }

  .site-nav {
    justify-content: center;
    gap: 32px;
  }

  .site-nav a,
  .product-footer a {
    color: hsl(var(--pc-muted));
    font-size: 13px;
    font-weight: 580;
    text-decoration: none;
  }

  .site-nav a:hover,
  .product-footer nav a:hover {
    color: hsl(var(--pc-text));
  }

  .nav-button,
  .primary-action,
  .secondary-action,
  .evidence-card a,
  .final-cta a,
  .recommendation-bar a {
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-button {
    gap: 10px;
    justify-self: end;
    border: 1px solid hsl(var(--pc-line-strong));
    background: hsl(var(--pc-panel));
    color: hsl(var(--pc-text));
    padding: 9px 14px;
    box-shadow: 0 12px 28px hsl(var(--pc-shadow) / 0.06);
  }

  .nav-button img {
    width: 17px;
    height: 17px;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px;
    align-items: start;
    padding: 56px 0 48px;
    min-height: auto;
  }

  .hero-copy h1 {
    max-width: 520px;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 520;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-family: "Instrument Sans", sans-serif;
  }

  .hero-copy h1::selection,
  .section-copy h2::selection {
    background: hsl(var(--pc-profit) / 0.24);
  }

  .hero-copy p {
    max-width: 470px;
    margin-top: 20px;
    color: hsl(var(--pc-muted));
    font-size: 18px;
    line-height: 1.55;
  }

  .hero-actions {
    gap: 14px;
    margin-top: 28px;
  }

  .entry-strip {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    border: 1px solid hsl(var(--pc-line));
    border-radius: 18px;
    background:
      linear-gradient(135deg, hsl(var(--pc-profit) / 0.08), transparent 52%),
      hsl(var(--pc-panel) / 0.94);
    padding: 14px 16px;
    box-shadow: 0 18px 38px hsl(var(--pc-shadow) / 0.06);
  }

  .entry-strip strong {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--pc-subtle));
  }

  .entry-strip div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .entry-strip span {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    border: 1px solid hsl(var(--pc-line));
    border-radius: 999px;
    background: hsl(var(--pc-panel-2));
    padding: 0 12px;
    font-size: 12px;
    font-weight: 650;
    color: hsl(var(--pc-text));
  }

  .primary-action,
  .secondary-action,
  .final-cta a {
    min-height: 48px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .primary-action {
    background: hsl(var(--pc-text));
    color: hsl(var(--pc-panel));
    box-shadow: 0 18px 38px hsl(var(--pc-shadow) / 0.12);
  }

  .secondary-action {
    border: 1px solid hsl(var(--pc-line-strong));
    background: hsl(var(--pc-panel));
    color: hsl(var(--pc-text));
  }

  .proof-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    gap: 5px 14px;
    margin-top: 20px;
  }

  .proof-points article {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    gap: 5px;
  }

  .proof-points span {
    width: 18px;
    height: 18px;
    border-radius: 999px;
