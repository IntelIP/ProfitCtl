---
import ProductLayout from "../layouts/ProductLayout.astro";
import DecisionHero from "../components/DecisionHero.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import VideoOverview from "../components/VideoOverview.astro";
import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const example = calculateExample({ users: 1000, requests: 60, price: 20 });
const command = ["git clone \\" , "  " + repoUrl, "cd ProfitCtl", "go run . compare \\", "  examples/hybrid_steady_profit.yml \\", "  examples/hybrid_profit.yml"].join("\n");
const steps = [
  { number: "01", title: "Start with what changes.", detail: "Describe usage, pricing, model calls, and infrastructure. Keep each cost tied to its source and assumptions.", mark: "Usage + rates + pricing" },
  { number: "02", title: "Put the options side by side.", detail: "Compare a feature, model, deployment, or pricing plan. See the effect on revenue, recurring margin, and cost per user.", mark: "Baseline → candidate" },
  { number: "03", title: "Set the limits before you ship.", detail: "Test margin and cost targets, including growth and tail risk. Keep the decision evidence in your review.", mark: "Margins + cost targets" },
];
---

<ProductLayout title="ProfitCTL | Open-Source AI Cost Modeling & Margin Planning" description="Model AI and infrastructure costs, compare product scenarios, and check profit margins before you ship. Try ProfitCTL's interactive example and local CLI.">
  <DecisionHero />

  <VideoOverview />
  <TerminalDemo />

  <section class="site-shell calculator-section" id="calculator" data-reveal>
    <details class="calculator-disclosure"><summary>Explore the cost calculator <span aria-hidden="true">+</span></summary>
    <div class="calculator-intro"><h2>Try your own assumptions.</h2><p>Adjust this separate illustration to explore usage and pricing.</p></div>
    <div class="demo-shell" data-demo>
      <div class="demo-toolbar"><div><span class="status-dot" /> Interactive example</div><span>Sample costs · {exampleMarginTarget}% margin target</span></div>
      <div class="demo-grid">
        <div class="demo-inputs">
          <h3>Your assumptions</h3>
          <div class="demo-presets" role="group" aria-label="Example scenarios">
            <button type="button" data-preset="feature" aria-pressed="true">AI feature</button><button type="button" data-preset="pricing" aria-pressed="false">Pricing</button><button type="button" data-preset="growth" aria-pressed="false">Growth</button>
          </div>
          <div class="input-row"><div><label for="demo-users">Monthly active users</label><output id="users-value" for="demo-users">1,000</output></div><input id="demo-users" type="range" min="100" max="20000" step="100" value="1000" /><p>How many people use the product?</p></div>
          <div class="input-row"><div><label for="demo-requests">AI requests per user</label><output id="requests-value" for="demo-requests">60</output></div><input id="demo-requests" type="range" min="10" max="300" step="10" value="60" /><p>Monthly usage per active user.</p></div>
          <div class="input-row"><div><label for="demo-price">Price per user / month</label><output id="price-value" for="demo-price">$20</output></div><input id="demo-price" type="range" min="5" max="60" step="1" value="20" /><p>The recurring revenue from each user.</p></div>
          <p class="demo-error" data-demo-error role="alert" />
          <details class="assumptions"><summary>Inspect the sample costs <span aria-hidden="true">+</span></summary><div><p>Both options use $400 monthly overhead and $1.50 per user in other variable costs.</p><p>Basic responses cost $0.01 per request. Research-enabled responses cost $0.08 per request.</p><p>This example calculates gross margin. Fees, growth distributions, and full stress tests belong in your CLI scenario.</p></div></details>
        </div>
        <div class="demo-results">
          <div class="revenue-strip"><span>Modeled monthly revenue</span><strong data-revenue>{money(example.revenue)}</strong></div>
          <div class="results-pair">
            <article class="result-card"><p class="option-label">Baseline</p><h3>Basic responses</h3><dl><div><dt>Cost / month</dt><dd data-baseline-cost>{money(example.baseline.cost)}</dd></div><div><dt>Gross margin</dt><dd data-baseline-margin>{percent(example.baseline.margin)}</dd></div><div><dt>Cost / user</dt><dd data-baseline-unit>{money(example.baseline.unitCost, 2)}</dd></div></dl></article>
            <article class="result-card candidate"><p class="option-label">With the feature</p><h3>Research-enabled</h3><dl><div><dt>Cost / month</dt><dd data-candidate-cost>{money(example.candidate.cost)}</dd></div><div><dt>Gross margin</dt><dd data-candidate-margin>{percent(example.candidate.margin)}</dd></div><div><dt>Cost / user</dt><dd data-candidate-unit>{money(example.candidate.unitCost, 2)}</dd></div></dl></article>
          </div>
          <div class="cost-bars" aria-hidden="true"><p>Share of revenue spent</p><div><span>Basic</span><div class="bar-track"><i data-baseline-bar style={`width:${example.baseline.cost / example.revenue * 100}%`} /></div></div><div><span>Research</span><div class="bar-track"><i data-candidate-bar style={`width:${example.candidate.cost / example.revenue * 100}%`} /></div></div></div>
          <div class="verdict" data-verdict data-state="pass" role="status" aria-live="polite" aria-atomic="true"><span class="verdict-icon" aria-hidden="true">↗</span><div><h3 data-verdict-title>The feature clears your margin target.</h3><p data-verdict-detail>Research adds {money(example.addedCost)} per month. The modeled margin meets the {exampleMarginTarget}% target.</p></div></div>
        </div>
      </div>
      <noscript><p class="no-script">These are the default example values. Enable JavaScript to adjust them, or run a scenario in the CLI.</p></noscript>
    </div>
    <p class="demo-caption">An adjustable illustration using sample costs. Your real decisions need your own rates, usage, and evidence.</p>
    </details>
  </section>

  <section class="site-shell how-section" id="how-it-works" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">02 / The workflow</p><h2>From an assumption<br />to a decision you can defend.</h2></div><p>Follow the same workflow with your own saved scenarios, cost sources, simulations, and explicit guardrails.</p></div>
    <div class="steps-grid">{steps.map((step) => <article class="step-card"><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.detail}</p><div class="step-mark">{step.mark}</div></article>)}</div>
    <div class="delivery-row"><p>Use the same scenario where your team makes decisions.</p><div><span>Local CLI</span><span>Codex skill</span><span>Pull request checks</span></div></div>
  </section>

  <section class="site-shell evidence-section" data-reveal>
    <div class="evidence-copy"><p class="eyebrow">03 / Keep the evidence</p><h2>Inspect the assumptions<br />behind the answer.</h2><p>A cost estimate is useful when you can explain it. ProfitCtl keeps sources, confidence, and profitability targets alongside the result.</p><div class="evidence-tags"><span>Source + capture date</span><span>Confidence + notes</span><span>Margin + cost targets</span></div></div>
    <div class="questions">
      <details><summary>Can I use my own costs? <span aria-hidden="true">+</span></summary><p>Yes. Save pricing, fixed and variable costs, usage, and targets in a YAML scenario. Compare it with another option, then inspect the output.</p></details>
      <details><summary>What happens when usage grows? <span aria-hidden="true">+</span></summary><p>Use simulations and growth scenarios to test margin and cost limits. Tail-risk checks help expose outcomes that an average alone can hide.</p></details>
      <details><summary>What is available today? <span aria-hidden="true">+</span></summary><p>The open-source local CLI, Codex skill, and CI output are available. Hosted workspaces, saved team history, and approvals are planned.</p></details>
    </div>
  </section>

  <section class="site-shell start-section" id="get-started" data-reveal>
    <div class="start-copy"><p class="eyebrow">04 / Make it yours</p><h2>Bring one<br />real decision.</h2><p>Start with a saved comparison. Then replace the assumptions with your own costs and usage.</p><a class="primary-action" href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a><p class="prerequisite">This source-based quick start requires Git and Go. Release installation is covered in the documentation.</p></div>
    <div class="terminal"><div class="terminal-header"><span>Terminal · Git + Go</span><button type="button" data-copy-command>Copy command</button></div><pre><code data-start-command>{command}</code></pre><div class="terminal-footer"><span class="status-dot" /> Compare two committed examples, locally.</div></div>
  </section>

  <script>
    import { initializeDemo } from "../scripts/demo";
    initializeDemo();
  </script>
</ProductLayout>

<style>
  .eyebrow { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .055em; text-transform: uppercase; line-height: 1.6; }
  .status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
  .primary-action { display: inline-flex; align-items: center; gap: 32px; min-height: 50px; margin-top: 28px; padding: 0 22px; border-radius: 999px; background: var(--ink); color: var(--on-ink); font-size: 14px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .primary-action:hover { transform: translateY(-3px); box-shadow: 0 10px 20px #20251d15; }
  .section-heading { display: grid; grid-template-columns: 1.1fr 1fr; align-items: end; gap: 48px; margin-bottom: 30px; }
  h2 { margin-top: 12px; font-size: clamp(30px, 3.25vw, 43px); line-height: 1.13; letter-spacing: -.05em; font-weight: 540; text-wrap: balance; }
  .section-heading > p { max-width: 430px; font-size: 15px; line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .demo-shell { overflow: hidden; border: 1px solid light-dark(#cfd7c4, #29372f); border-radius: 24px; background: var(--panel); box-shadow: 0 24px 50px #343c2710; }
  .demo-toolbar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 16px 24px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--muted); background: light-dark(#fafbf6, #111a16); }.demo-toolbar > div { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 600; }
  .demo-grid { display: grid; grid-template-columns: .8fr 1.2fr; }.demo-inputs { padding: 28px; border-right: 1px solid var(--line); }.demo-inputs h3 { font-size: 17px; font-weight: 600; }
  .demo-presets { display: flex; padding: 4px; gap: 4px; margin-top: 18px; border: 1px solid var(--line); border-radius: 999px; background: light-dark(#f7f8f2, #111a16); }.demo-presets button { flex: 1; padding: 8px 10px; min-height: 38px; border: 0; border-radius: 999px; background: transparent; font-size: 11px; color: var(--muted); white-space: nowrap; transition: background .2s, color .2s; }.demo-presets button[aria-pressed=true] { background: var(--ink); color: var(--on-ink); }
  .input-row { margin-top: 28px; }.input-row > div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }.input-row label { font-size: 12px; line-height: 1.5; color: var(--muted); }.input-row output { font-size: 19px; font-weight: 580; font-variant-numeric: tabular-nums; }.input-row input { display: block; width: 100%; min-height: 28px; margin: 10px 0 2px; accent-color: var(--green); cursor: pointer; }.input-row p { font-size: 10px; color: var(--muted); line-height: 1.5; }
  .demo-error { color: var(--risk); font-size: 12px; line-height: 1.5; }.demo-error:not(:empty) { margin-top: 14px; }
  details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; }details summary::-webkit-details-marker { display: none; }details summary > span { font-size: 19px; font-weight: 400; transition: transform .2s; }details[open] summary > span { transform: rotate(45deg); }
  .assumptions { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 10px; }.assumptions summary { min-height: 38px; font-size: 11px; font-weight: 550; }.assumptions p { margin-top: 10px; font-size: 11px; line-height: 1.6; color: var(--muted); }
  .demo-results { padding: 28px; background: linear-gradient(150deg,light-dark(#f8faf2, #111a16),var(--panel) 70%); }.revenue-strip { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 20px; font-size: 12px; color: var(--muted); }.revenue-strip strong { color: var(--ink); font-size: 26px; font-weight: 550; font-variant-numeric: tabular-nums; }
  .results-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); grid-template-rows: auto auto auto; gap: 8px 12px; }.result-card { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: 8px; border: 1px solid var(--line); border-radius: 16px; padding: 18px; background: var(--panel); }.candidate { border-color: light-dark(#bbcdac, #34483b); background: light-dark(#f1f6e9, #19251d); }.option-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }.result-card h3 { font-size: 15px; line-height: 1.4; font-weight: 600; }.result-card dl { display: grid; gap: 16px; margin-top: 12px; }.result-card dt { font-size: 11px; color: var(--muted); }.result-card dd { margin-top: 5px; font-size: 24px; line-height: 1.2; font-weight: 550; font-variant-numeric: tabular-nums; }.result-card dl > div:first-child dd { font-size: 30px; letter-spacing: -.04em; }
  .cost-bars { margin-top: 24px; }.cost-bars > p { margin-bottom: 14px; color: var(--muted); font-size: 11px; }.cost-bars > div { display: grid; grid-template-columns: 64px 1fr; align-items: center; gap: 14px; margin-top: 12px; font-size: 11px; }.bar-track { height: 10px; border-radius: 999px; overflow: hidden; background: light-dark(#e6ebde, #24342a); }.bar-track i { display: block; height: 100%; border-radius: 999px; background: light-dark(#939e85, #6d7f70); transition: width .55s cubic-bezier(.2,.8,.2,1); }.bar-track [data-candidate-bar] { background: var(--green); }
  .verdict { display: flex; gap: 12px; margin-top: 26px; padding: 18px; border-radius: 14px; border: 1px solid light-dark(#cfdec0, #3f5544); background: light-dark(#e9f1df, #1b281f); }.verdict-icon { display: grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--green); color: var(--on-ink); }.verdict h3 { font-size: 13px; font-weight: 600; line-height: 1.5; }.verdict p { margin-top: 6px; color: var(--muted); font-size: 11px; line-height: 1.6; }.verdict[data-state=risk] { border-color: light-dark(#e5c5b9, #725747); background: light-dark(#fcf0e9, #291d18); }.verdict[data-state=risk] .verdict-icon { background: var(--risk); }
  .demo-caption, .no-script { margin-top: 16px; font-size: 11px; line-height: 1.6; color: var(--muted); }.no-script { padding: 0 24px 20px; }
  .calculator-section { margin-top: 32px; }.calculator-disclosure { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 12px; }.calculator-disclosure > summary { min-height: 44px; font-size: 14px; color: var(--green); font-weight: 550; }.calculator-intro { margin-block: 22px; }.calculator-intro h2 { font-size: 25px; }.calculator-intro p { margin-top: 12px; font-size: 14px; line-height: 1.7; color: var(--muted); }
  .how-section { padding-top: 100px; }.steps-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); grid-template-rows: auto auto auto auto; gap: 18px 28px; }.step-card { display: grid; grid-row: span 4; grid-template-rows: subgrid; gap: 18px; padding: 26px 0; border-top: 1px solid light-dark(#b6c0aa, #34483b); }.step-number { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid light-dark(#c3d1b6, #34483b); border-radius: 50%; color: var(--green); font-size: 12px; }.step-card h3 { font-size: 21px; font-weight: 560; line-height: 1.3; letter-spacing: -.025em; text-wrap: balance; }.step-card p { color: var(--muted); font-size: 14px; line-height: 1.7; text-wrap: pretty; }.step-mark { width: fit-content; border: 1px solid light-dark(#d4dccb, #29372f); border-radius: 8px; padding: 8px 12px; background: light-dark(#ecefe5, #111a16); color: var(--green); font-size: 10px; }
  .delivery-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 24px; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }.delivery-row p { font-size: 13px; color: var(--muted); }.delivery-row > div { display: flex; flex-wrap: wrap; gap: 10px; }.delivery-row span { font-size: 11px; border-radius: 999px; padding: 8px 12px; border: 1px solid var(--line); background: light-dark(#fcfcf8, #111a16); }
  .evidence-section { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; padding-top: 100px; align-items: start; }.evidence-copy > p:not(.eyebrow) { max-width: 430px; margin-top: 20px; font-size: 15px; line-height: 1.7; color: var(--muted); text-wrap: pretty; }.evidence-tags { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 22px; }.evidence-tags span { font-size: 10px; color: var(--green); }.questions { border-top: 1px solid light-dark(#bbc5af, #34483b); }.questions details { border-bottom: 1px solid light-dark(#cfd6c5, #29372f); padding-block: 14px; }.questions summary { min-height: 46px; font-size: 15px; font-weight: 550; line-height: 1.5; }.questions p { padding: 10px 32px 8px 0; font-size: 13px; color: var(--muted); line-height: 1.7; }
  .start-section { display: grid; grid-template-columns: .75fr 1.25fr; gap: 48px; align-items: center; margin-top: 100px; padding: 38px; border-radius: 26px; background: light-dark(#e7eddc, #151f19); border: 1px solid light-dark(#d4ddc8, #29372f); }.start-copy > p:not(.eyebrow) { margin-top: 18px; font-size: 14px; color: var(--muted); line-height: 1.7; }.start-copy .prerequisite { font-size: 11px !important; }.terminal { overflow: hidden; min-width: 0; border: 1px solid light-dark(#4d5842, #344038); border-radius: 16px; background: light-dark(#252d21, #0c1410); color: light-dark(#eef4e6, #dddeda); }.terminal-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 10px 16px; border-bottom: 1px solid light-dark(#4a553f, #29372f); font-size: 10px; color: light-dark(#c1cfb5, #a3aea5); }.terminal-header button { border: 1px solid light-dark(#67785a, #4b5c4f); border-radius: 7px; background: light-dark(#36442c, #223027); color: light-dark(#edf6e3, #dddeda); min-height: 38px; padding: 8px 12px; font-size: 10px; line-height: 1.4; }.terminal pre { margin: 0; padding: 24px 20px; font-size: 12px; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }.terminal-footer { display: flex; align-items: center; gap: 8px; padding: 16px; border-top: 1px solid light-dark(#4a553f, #29372f); font-size: 10px; color: light-dark(#c1cfb5, #a3aea5); }.terminal-footer .status-dot { background: var(--accent); }
  @keyframes arrive { from { transform: translateY(14px); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
  .is-visible { animation: arrive .7s ease-out both; }
  @media (max-width: 980px) {
    .section-heading { gap: 28px; }.demo-inputs, .demo-results { padding: 22px; }.demo-grid { grid-template-columns: .85fr 1.15fr; }.demo-presets { flex-wrap: wrap; border-radius: 12px; }.result-card { padding: 14px; }.result-card dl > div:first-child dd { font-size: 26px; }.evidence-section { gap: 36px; }.start-section { gap: 28px; padding: 28px; grid-template-columns: .8fr 1.2fr; }
  }
  @media (max-width: 760px) {
    .section-heading, .evidence-section { grid-template-columns: 1fr; gap: 20px; }.section-heading > p { max-width: 540px; }.demo-grid { grid-template-columns: 1fr; }.demo-inputs { border-right: 0; border-bottom: 1px solid var(--line); }.demo-presets { flex-wrap: nowrap; border-radius: 999px; }.input-row { margin-top: 24px; }.steps-grid { grid-template-columns: 1fr; grid-template-rows: none; gap: 8px; }.step-card { grid-row: auto; grid-template-rows: auto; gap: 14px; }.step-card p { max-width: 550px; }.how-section, .evidence-section { padding-top: 64px; }.start-section { grid-template-columns: 1fr; margin-top: 64px; gap: 28px; }.start-copy h2 br { display: none; }
  }
  @media (max-width: 420px) {
    h2 { font-size: 31px; }.demo-toolbar { padding: 14px 18px; font-size: 10px; }.demo-inputs, .demo-results { padding: 20px 16px; }.demo-presets button { min-height: 40px; padding-inline: 8px; }.results-pair { gap: 8px; }.result-card { padding: 12px; }.result-card h3 { font-size: 13px; }.result-card dl > div:first-child dd { font-size: 25px; }.result-card dd { font-size: 22px; }.result-card dt { font-size: 10px; }.revenue-strip strong { font-size: 24px; }.revenue-strip { font-size: 11px; gap: 10px; }.verdict { padding: 14px; gap: 10px; }.verdict h3 { font-size: 12px; }.verdict p { font-size: 11px; }.start-section { padding: 24px 18px; }.terminal-header { padding: 10px 12px; }.terminal pre { padding: 18px 12px; font-size: 11px; }.terminal-footer { padding: 12px; font-size: 9px; }
  }
</style>
