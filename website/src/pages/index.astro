---
import "@fontsource/instrument-sans/latin-500.css";
import "@fontsource/instrument-sans/latin-600.css";
import ProductLayout from "../layouts/ProductLayout.astro";
import DecisionHero from "../components/DecisionHero.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const example = calculateExample({ users: 1000, requests: 60, price: 20 });
const command = ["git clone \\" , "  " + repoUrl, "cd ProfitCtl", "go run . compare \\", "  examples/hybrid_steady_profit.yml \\", "  examples/hybrid_profit.yml"].join("\n");
const steps = [
  { number: "01", title: "Start with what changes.", detail: "Describe usage, pricing, model calls, and infrastructure. Keep each cost tied to its source and assumptions.", mark: "Usage + rates + pricing" },
  { number: "02", title: "Put the options side by side.", detail: "Compare a feature, model, deployment, or pricing plan. See the effect on revenue, margin, and cost per user.", mark: "Today → proposed" },
  { number: "03", title: "Set the limits before you ship.", detail: "Test margin and cost targets, including growth and tail risk. Keep the decision evidence in your review.", mark: "Margins + cost targets" },
];
---

<ProductLayout title="ProfitCTL | Open-Source AI Cost Modeling & Margin Planning" description="Model AI and infrastructure costs, compare product scenarios, and check profit margins before you ship. Try ProfitCTL's interactive example and local CLI.">
  <DecisionHero />

  <section class="site-shell calculator-section" id="calculator">
    <details class="calculator-disclosure"><summary>Explore the cost calculator <span aria-hidden="true">+</span></summary>
    <div class="calculator-intro"><h3>Try your own assumptions.</h3><p>Change the price, user count or requests. Both options use the same sample rates.</p></div>
    <div class="demo-shell" data-demo>
      <div class="demo-toolbar"><div><span class="status-dot" /> Interactive example</div><span>Sample costs · {exampleMarginTarget}% margin target</span></div>
      <div class="demo-grid">
        <div class="demo-inputs">
          <h3>Your assumptions</h3>
          <div class="demo-presets" role="group" aria-label="Example scenarios">
            <button type="button" data-preset="feature" aria-pressed="true">AI feature</button><button type="button" data-preset="pricing" aria-pressed="false">Pricing</button><button type="button" data-preset="growth" aria-pressed="false">Growth</button>
          </div>
          <div class="input-row"><div><label for="demo-users">Monthly active users</label><output id="users-value" for="demo-users">1,000</output></div><input id="demo-users" type="range" min="100" max="20000" step="100" value="1000" /><p>How many people use the product?</p></div>
          <div class="input-row"><div><label for="demo-requests">AI requests per user</label><output id="requests-value" for="demo-requests">60</output></div><input id="demo-requests" type="range" min="10" max="300" step="10" value="60" /><p>Monthly usage per active user.</p></div>
          <div class="input-row"><div><label for="demo-price">Price per user / month</label><output id="price-value" for="demo-price">$20</output></div><input id="demo-price" type="range" min="5" max="60" step="1" value="20" /><p>The recurring revenue from each user.</p></div>
          <p class="demo-error" data-demo-error role="alert" />
          <details class="assumptions"><summary>Inspect the sample costs <span aria-hidden="true">+</span></summary><div><p>Both options use $400 monthly overhead and $1.50 per user in other variable costs.</p><p>A basic answer costs $0.01 per request. A research request costs $0.08.</p><p>This example calculates gross margin only. Payment fees, growth over time and stress tests are available in the command-line tool.</p></div></details>
        </div>
        <div class="demo-results">
          <div class="revenue-strip"><span>Modeled monthly revenue</span><strong data-revenue>{money(example.revenue)}</strong></div>
          <div class="results-pair">
            <article class="result-card"><p class="option-label">Today</p><h3>Basic answers</h3><dl><div><dt>Cost / month</dt><dd data-baseline-cost>{money(example.baseline.cost)}</dd></div><div><dt>Gross margin</dt><dd data-baseline-margin>{percent(example.baseline.margin)}</dd></div><div><dt>Cost / user</dt><dd data-baseline-unit>{money(example.baseline.unitCost, 2)}</dd></div></dl></article>
            <article class="result-card candidate"><p class="option-label">With the feature</p><h3>With research</h3><dl><div><dt>Cost / month</dt><dd data-candidate-cost>{money(example.candidate.cost)}</dd></div><div><dt>Gross margin</dt><dd data-candidate-margin>{percent(example.candidate.margin)}</dd></div><div><dt>Cost / user</dt><dd data-candidate-unit>{money(example.candidate.unitCost, 2)}</dd></div></dl></article>
          </div>
          <div class="cost-bars" aria-hidden="true" style={`--target:${exampleMarginTarget}%`}><p>Gross margin against the {exampleMarginTarget}% target</p><div><span>Basic</span><div class="bar-track"><i data-baseline-bar style={`width:${example.baseline.margin}%`} /></div></div><div><span>Research</span><div class="bar-track"><i data-candidate-bar style={`width:${example.candidate.margin}%`} /></div></div></div>
          <div class="verdict" data-verdict data-state="pass" role="status" aria-live="polite" aria-atomic="true"><span class="verdict-icon" aria-hidden="true">↗</span><div><h3 data-verdict-title>The feature clears your margin target.</h3><p data-verdict-detail>Research adds {money(example.addedCost)} per month. The modeled margin meets the {exampleMarginTarget}% target.</p></div></div>
        </div>
      </div>
      <noscript><p class="no-script">These are the default example values. Enable JavaScript to adjust them, or run a scenario in the CLI.</p></noscript>
    </div>
    <p class="demo-caption">This is an illustration with sample costs. A real decision needs your own rates and usage.</p>
    </details>
  </section>

  <TerminalDemo />

  <section class="site-shell plain-section how-section" id="how-it-works">
    <div class="section-heading"><p class="eyebrow">The workflow</p><h2 class="section-title">From a cost assumption to a decision.</h2><p class="lede">Use saved scenarios to connect each assumption to a cost, a comparison and a margin you can defend.</p></div>
    <ol class="steps-grid" role="list">
      {steps.map((step) => (
        <li class="step-card">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
          <div class="step-mark">{step.mark}</div>
        </li>
      ))}
    </ol>
    <div class="delivery-row"><p>Run the same scenario in each tool.</p><div><span>Local CLI</span><span>Codex skill</span><span>Pull request checks</span></div></div>
  </section>

  <div class="evidence-band band">
  <section class="site-shell evidence-section">
    <div class="evidence-copy">
      <p class="eyebrow">Evidence and assumptions</p>
      <h2 class="section-title">Keep the evidence with the estimate.</h2>
      <p class="lede">Trace each estimate to its rates, assumptions and margin targets.</p>
      <ul class="evidence-fields">
        <li>Source + capture date</li>
        <li>Confidence + notes</li>
        <li>Margin + cost targets</li>
      </ul>
    </div>
    <div class="questions">
      <details><summary>Can I use my own costs? <span aria-hidden="true">+</span></summary><p>Yes. Save pricing, fixed and variable costs, usage, and targets in a YAML scenario. Compare it with another option, then inspect the output.</p></details>
      <details><summary>What happens when usage grows? <span aria-hidden="true">+</span></summary><p>Use simulations and growth scenarios to test margin and cost limits. Tail-risk checks help expose outcomes that an average alone can hide.</p></details>
      <details><summary>What is available today? <span aria-hidden="true">+</span></summary><p>The open-source local CLI, Codex skill, and CI output are available. Hosted workspaces, saved team history, and approvals are planned.</p></details>
    </div>
  </section>

  </div>

  <section class="site-shell plain-section start-section" id="get-started">
    <div class="start-copy"><p class="eyebrow">Make it yours</p><h2 class="section-title">Bring one real decision.</h2><p class="lede">Start with a saved comparison. Then replace the assumptions with your own costs and usage.</p><a class="primary-action" href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a><p>This quick start builds from source, so it needs Git and Go. For a ready-made download, see the <a href={repoUrl + "/blob/main/docs/INSTALL.md"} target="_blank" rel="noopener noreferrer">installation guide</a>.</p></div>
    <div class="terminal"><div class="terminal-header"><span>Terminal · Git + Go</span><button type="button" data-copy-command aria-live="polite">Copy command</button></div><pre><code data-start-command>{command}</code></pre><div class="terminal-footer"><span class="status-dot" /> Compare two committed examples, locally.</div></div>
  </section>

  <script>
    import { initializeDemo } from "../scripts/demo";
    initializeDemo();
  </script>
</ProductLayout>

<style>
  .status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--series-research); }
  .primary-action { display: inline-flex; align-items: center; gap: 16px; min-height: 48px; margin-top: 28px; padding: 0 24px; border-radius: 999px; background: light-dark(var(--ink), var(--icon-sage)); color: light-dark(var(--on-ink), var(--icon-ink)); font-size: var(--text-body); font-weight: 600; text-decoration: none; transition: background-color .15s ease; }
  .primary-action:hover { background: light-dark(#3a4136, #c3ccc4); }
  .demo-shell { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); }
  .demo-toolbar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 16px 24px; border-bottom: 1px solid var(--line); font-size: var(--text-small); color: var(--muted); }.demo-toolbar > div { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 600; }
  .demo-grid { display: grid; grid-template-columns: .8fr 1.2fr; }.demo-inputs { padding: 24px; border-right: 1px solid var(--line); }.demo-inputs h3 { font-size: var(--text-body); font-weight: 600; }
  .demo-presets { display: flex; padding: 4px; gap: 4px; margin-top: 16px; border-radius: 999px; background: light-dark(#f1f4ea, var(--dark-canvas)); }.demo-presets button { flex: 1; padding: 8px 10px; min-height: 44px; border: 0; border-radius: 999px; background: transparent; font-size: var(--text-small); color: var(--muted); white-space: nowrap; transition: background .2s, color .2s; }.demo-presets button[aria-pressed=true] { background: var(--ink); color: var(--on-ink); font-weight: 600; }
  .input-row { margin-top: 24px; }.input-row > div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }.input-row label { font-size: var(--text-small); line-height: 1.5; color: var(--muted); }.input-row output { font-size: var(--text-lede); font-weight: 600; font-variant-numeric: tabular-nums; }.input-row input { display: block; width: 100%; min-height: 44px; margin: 0; accent-color: var(--series-research); cursor: pointer; }.input-row p { font-size: var(--text-small); color: var(--muted); line-height: 1.5; }
  .demo-error { color: var(--risk); font-size: var(--text-small); line-height: 1.5; }.demo-error:not(:empty) { margin-top: 16px; }
  details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; }details summary::-webkit-details-marker { display: none; }details summary > span { font-size: 19px; font-weight: 400; transition: transform .2s; }details[open] summary > span { transform: rotate(45deg); }
  .assumptions { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 8px; }.assumptions summary { min-height: 44px; font-size: var(--text-small); font-weight: 600; }.assumptions p { margin-top: 8px; font-size: var(--text-small); line-height: 1.6; color: var(--muted); }
  .demo-results { padding: 24px; }.revenue-strip { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 16px; font-size: var(--text-small); color: var(--muted); }.revenue-strip strong { color: var(--ink); font-size: var(--text-h3); font-weight: 600; font-variant-numeric: tabular-nums; }
  .results-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); grid-template-rows: auto auto auto; gap: 8px 12px; }.result-card { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: 8px; border-radius: var(--radius); padding: 16px; background: var(--tint); }.result-card.candidate { box-shadow: inset 0 3px 0 var(--series-research); }.result-card:not(.candidate) { box-shadow: inset 0 3px 0 var(--series-basic); }.option-label { font-size: var(--text-small); color: var(--muted); }.result-card h3 { font-size: var(--text-body); line-height: 1.4; font-weight: 600; }.result-card dl { display: grid; gap: 16px; margin-top: 8px; }.result-card dt { font-size: var(--text-small); color: var(--muted); }.result-card dd { margin-top: 4px; font-size: var(--text-h3); line-height: 1.2; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cost-bars { margin-top: 24px; }.cost-bars > p { margin-bottom: 12px; color: var(--muted); font-size: var(--text-small); }.cost-bars > div { display: grid; grid-template-columns: 72px 1fr; align-items: center; gap: 12px; margin-top: 12px; font-size: var(--text-small); }.bar-track { position: relative; height: 10px; border-radius: 0 4px 4px 0; background: light-dark(#e6ebde, var(--dark-line)); }.bar-track::after { content: ""; position: absolute; inset-block: -4px; left: var(--target); border-left: 2px dashed var(--ink); }.bar-track i { display: block; height: 100%; border-radius: 0 4px 4px 0; background: var(--series-basic); transition: width .4s cubic-bezier(.2,.8,.2,1); }.bar-track [data-candidate-bar] { background: var(--series-research); }
  .verdict { display: flex; gap: 12px; margin-top: 24px; padding: 16px; border-radius: var(--radius); background: light-dark(#e4e9e3, #232a27); }.verdict-icon { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--series-research); color: var(--panel); }.verdict h3 { font-size: var(--text-small); font-weight: 600; line-height: 1.5; }.verdict p { margin-top: 4px; color: var(--muted); font-size: var(--text-small); line-height: 1.6; }.verdict[data-state=risk] { background: light-dark(#fbe6dc, #33201a); }.verdict[data-state=risk] .verdict-icon { background: var(--risk); }
  .demo-caption, .no-script { margin-top: 16px; font-size: var(--text-small); line-height: 1.6; color: var(--muted); }.no-script { padding: 0 24px 20px; }
  /* Sits between two panels, whose own margins already space it. */
  .calculator-section { padding-block: 0; }
  .calculator-disclosure { padding-block: 8px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .calculator-disclosure > summary { min-height: 56px; color: var(--ink); font-size: var(--text-lede); font-weight: 600; }
  .calculator-disclosure[open] { padding-bottom: 32px; }
  .calculator-intro { padding-block: 16px 24px; }
  .calculator-intro h3 { font-size: var(--text-h3); font-weight: 600; letter-spacing: -.02em; }
  .calculator-intro p { margin-top: 8px; color: var(--muted); font-size: var(--text-body); line-height: 1.6; }

  .section-heading { margin-bottom: clamp(32px, 4vw, 48px); }
  .steps-grid { margin: 0; padding: 0; list-style: none; }
  .step-card { display: grid; grid-template-columns: 48px minmax(0,1fr) minmax(0,1fr); gap: 8px clamp(24px,4vw,64px); align-items: baseline; padding: 24px 0; border-top: 1px solid var(--line); }
  .step-number { grid-column: 1; grid-row: 1 / 3; color: var(--muted); font: 500 var(--text-small)/1.5 var(--font-mono); }
  .step-card h3 { grid-column: 2; grid-row: 1 / 3; color: var(--ink); font-size: var(--text-h3); font-weight: 600; line-height: 1.2; letter-spacing: -.02em; text-wrap: balance; }
  .step-card p, .step-mark { grid-column: 3; }
  .step-card p { max-width: 56ch; color: var(--muted); font-size: var(--text-body); line-height: 1.55; text-wrap: pretty; }
  .step-mark { color: var(--muted); font-size: var(--text-small); font-weight: 500; line-height: 1.5; }
  .delivery-row { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .delivery-row p { color: var(--muted); font-size: var(--text-body); }
  .delivery-row > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .delivery-row span { padding: 6px 12px; border-radius: 999px; background: var(--tint); color: var(--ink); font-size: var(--text-small); font-weight: 500; line-height: 1.5; }
  .evidence-band { background: light-dark(var(--tint), var(--dark-surface)); }
  .evidence-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,7vw,96px); align-items: start; }
  .evidence-fields { display: grid; gap: 4px; margin: 16px 0 0; padding-inline-start: 1.2em; color: var(--ink); font-size: var(--text-body); line-height: 1.55; }
  .questions { border-top: 1px solid var(--line-strong); }
  .questions details { border-bottom: 1px solid var(--line-strong); }
  .calculator-disclosure > summary:hover, .questions summary:hover { color: var(--muted); }
  .questions summary { min-height: 68px; color: var(--ink); font-size: var(--text-lede); font-weight: 600; line-height: 1.4; }
  .questions p { padding: 0 24px 24px 0; color: var(--muted); font-size: var(--text-body); line-height: 1.6; }
  .start-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,7vw,96px); align-items: center; }
  .start-copy > p:last-child a { color: var(--ink); text-underline-offset: 4px; }
  .start-copy > p:last-child { margin-top: 16px; color: var(--muted); font-size: var(--text-small); line-height: 1.55; }
  .terminal { min-width: 0; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid light-dark(#3d4439, var(--dark-line)); background: var(--terminal-surface); color: light-dark(#eef6ed, var(--dark-text)); }
  .terminal-header, .terminal-footer { display: flex; align-items: center; gap: 8px; padding: 8px 16px; color: light-dark(#c8d9cc, var(--dark-muted)); font-size: var(--text-small); line-height: 1.5; }
  .terminal-header { justify-content: space-between; flex-wrap: wrap; border-bottom: 1px solid var(--terminal-rule); }
  .terminal-header button { min-width: 140px; min-height: 44px; padding: 6px 16px; border: 1px solid light-dark(#6f7a70, var(--dark-line-strong)); border-radius: 999px; background: light-dark(#2c3229, var(--dark-raised)); color: light-dark(#f0f6ee, var(--dark-text)); font-size: var(--text-small); }
  .terminal pre { margin: 0; padding: 24px 16px; font-size: 13px; line-height: 1.7; white-space: pre; overflow-x: auto; -webkit-font-smoothing: antialiased; }
  .terminal-footer { padding-block: 16px; border-top: 1px solid var(--terminal-rule); }
  .terminal-footer .status-dot { background: var(--terminal-accent); }
  @media (max-width: 980px) {
    .demo-grid { grid-template-columns: .85fr 1.15fr; }
    .demo-presets { flex-wrap: wrap; }
  }
  @media (max-width: 760px) {
    .evidence-section, .start-section, .demo-grid { grid-template-columns: minmax(0,1fr); }
    .step-card { grid-template-columns: 28px minmax(0,1fr); gap: 8px 12px; }
    .step-number, .step-card h3 { grid-row: 1; }
    .step-card p, .step-mark { grid-column: 2; }
    .demo-inputs { border-right: 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 440px) {
    .terminal pre { font-size: 12px; }
    .demo-toolbar { padding: 12px 16px; }
    .demo-inputs, .demo-results { padding: 16px; }
    .result-card { padding: 12px; }
  }
</style>
