---
import ProductLayout from "../layouts/ProductLayout.astro";
import { calculateExample, money, percent } from "../scripts/demo";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const example = calculateExample({ users: 1000, requests: 60, price: 20 });
const command = ["git clone \\" , "  " + repoUrl, "cd ProfitCtl", "go run . compare \\", "  examples/hybrid_steady_profit.yml \\", "  examples/hybrid_profit.yml"].join("\n");
const steps = [
  { number: "01", title: "Start with what changes.", detail: "Describe usage, pricing, model calls, and infrastructure. Keep each cost tied to its source and assumptions.", mark: "Usage + rates + pricing" },
  { number: "02", title: "Put the options side by side.", detail: "Compare a feature, model, deployment, or pricing plan. See the effect on revenue, recurring margin, and cost per user.", mark: "Baseline → candidate" },
  { number: "03", title: "Set the limits before you ship.", detail: "Test margin and cost targets, including growth and tail risk. Keep the decision evidence in your review.", mark: "Margins + cost targets" },
];
---

<ProductLayout title="ProfitCTL | Open-Source AI Cost Modeling & Margin Planning" description="Model AI and infrastructure costs, compare product scenarios, and check profit margins before you ship. Try ProfitCTL's interactive example and local CLI.">
  <section class="site-shell hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" /> Cost modeling for teams building AI products</p>
      <h1>Know your AI costs.<br /><span>Protect your margin.</span></h1>
      <p class="hero-description">A new feature changes more than the product. ProfitCtl helps you model the spend, compare your options, and decide what to ship.</p>
      <a class="primary-action" href="#demo">Try the demo <span aria-hidden="true">↓</span></a>
      <p class="hero-note">MIT licensed. Runs locally. No sign-up.</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-grid" />
      <div class="visual-heading"><span class="visual-dot" /> A decision, before commitment</div>
      <svg class="signal-path" viewBox="0 0 450 390" preserveAspectRatio="none"><path d="M226 40 V350" /><path class="path-flow" d="M226 40 V350" /></svg>
      <div class="signal-node node-one"><span class="node-icon">01</span><div><small>The change</small><strong>Add a research feature</strong></div><span class="node-tag">Scenario</span></div>
      <div class="signal-node node-two"><span class="node-icon">02</span><div><small>The trade-off</small><strong>More usage. More cost.</strong></div><span class="node-tag">Compare</span></div>
      <div class="signal-node node-three"><span class="node-icon">03</span><div><small>The decision</small><strong>Will the margin hold?</strong></div><span class="node-tag">Check</span></div>
      <div class="visual-caption">Follow the cost from assumption to decision.</div>
    </div>
  </section>

  <section class="site-shell demo-section" id="demo" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">01 / Try a decision</p><h2>What changes when<br />your feature gets used?</h2></div><p>Adjust the example. See how usage and pricing change the cost of adding research to an AI product.</p></div>
    <div class="demo-shell" data-demo>
      <div class="demo-toolbar"><div><span class="status-dot" /> Interactive example</div><span>Sample costs · 60% margin target</span></div>
      <div class="demo-grid">
        <div class="demo-inputs">
          <h3>Your assumptions</h3>
          <div class="demo-presets" role="group" aria-label="Example scenarios">
            <button type="button" data-preset="feature" aria-pressed="true">AI feature</button><button type="button" data-preset="pricing" aria-pressed="false">Pricing</button><button type="button" data-preset="growth" aria-pressed="false">Growth</button>
          </div>
          <div class="input-row"><div><label for="demo-users">Monthly active users</label><output id="users-value" for="demo-users">1,000</output></div><input id="demo-users" type="range" min="100" max="20000" step="100" value="1000" /><p>How many people use the product?</p></div>
          <div class="input-row"><div><label for="demo-requests">AI requests per user</label><output id="requests-value" for="demo-requests">60</output></div><input id="demo-requests" type="range" min="10" max="300" step="10" value="60" /><p>Monthly usage per active user.</p></div>
          <div class="input-row"><div><label for="demo-price">Price per user / month</label><output id="price-value" for="demo-price">$20</output></div><input id="demo-price" type="range" min="5" max="60" step="1" value="20" /><p>The recurring revenue from each user.</p></div>
          <p class="demo-error" data-demo-error role="alert" />
          <details class="assumptions"><summary>Inspect the sample costs <span aria-hidden="true">+</span></summary><div><p>Both options use $400 monthly overhead and $1.50 per user in other variable costs.</p><p>Basic responses cost $0.01 per request. Research-enabled responses cost $0.08 per request.</p><p>This example calculates gross margin. Fees, growth distributions, and full stress tests belong in your CLI scenario.</p></div></details>
        </div>
        <div class="demo-results">
          <div class="revenue-strip"><span>Modeled monthly revenue</span><strong data-revenue>{money(example.revenue)}</strong></div>
          <div class="results-pair">
            <article class="result-card"><p class="option-label">Baseline</p><h3>Basic responses</h3><dl><div><dt>Cost / month</dt><dd data-baseline-cost>{money(example.baseline.cost)}</dd></div><div><dt>Gross margin</dt><dd data-baseline-margin>{percent(example.baseline.margin)}</dd></div><div><dt>Cost / user</dt><dd data-baseline-unit>{money(example.baseline.unitCost, 2)}</dd></div></dl></article>
            <article class="result-card candidate"><p class="option-label">With the feature</p><h3>Research-enabled</h3><dl><div><dt>Cost / month</dt><dd data-candidate-cost>{money(example.candidate.cost)}</dd></div><div><dt>Gross margin</dt><dd data-candidate-margin>{percent(example.candidate.margin)}</dd></div><div><dt>Cost / user</dt><dd data-candidate-unit>{money(example.candidate.unitCost, 2)}</dd></div></dl></article>
          </div>
          <div class="cost-bars" aria-hidden="true"><p>Share of revenue spent</p><div><span>Basic</span><div class="bar-track"><i data-baseline-bar style={`width:${example.baseline.cost / example.revenue * 100}%`} /></div></div><div><span>Research</span><div class="bar-track"><i data-candidate-bar style={`width:${example.candidate.cost / example.revenue * 100}%`} /></div></div></div>
          <div class="verdict" data-verdict data-state="pass" role="status" aria-live="polite" aria-atomic="true"><span class="verdict-icon" aria-hidden="true">↗</span><div><h3 data-verdict-title>The feature clears your margin target.</h3><p data-verdict-detail>Research adds {money(example.addedCost)} per month. The modeled margin stays above 60%.</p></div></div>
        </div>
      </div>
      <noscript><p class="no-script">These are the default example values. Enable JavaScript to adjust them, or run a scenario in the CLI.</p></noscript>
    </div>
    <p class="demo-caption">An adjustable illustration using sample costs. Your real decisions need your own rates, usage, and evidence.</p>
  </section>

  <section class="site-shell how-section" id="how-it-works" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">02 / The workflow</p><h2>From an assumption<br />to a decision you can defend.</h2></div><p>The demo shows the trade-off. ProfitCtl takes it further with saved scenarios, cost sources, simulations, and explicit guardrails.</p></div>
    <div class="steps-grid">{steps.map((step) => <article class="step-card"><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.detail}</p><div class="step-mark">{step.mark}</div></article>)}</div>
    <div class="delivery-row"><p>Use the same scenario where your team makes decisions.</p><div><span>Local CLI</span><span>Codex skill</span><span>Pull request checks</span></div></div>
  </section>

  <section class="site-shell evidence-section" data-reveal>
    <div class="evidence-copy"><p class="eyebrow">03 / Keep the evidence</p><h2>Inspect the assumptions<br />behind the answer.</h2><p>A cost estimate is useful when you can explain it. ProfitCtl keeps sources, confidence, and profitability targets alongside the result.</p><div class="evidence-tags"><span>Source + capture date</span><span>Confidence + notes</span><span>Margin + cost targets</span></div></div>
    <div class="questions">
      <details><summary>Can I use my own costs? <span aria-hidden="true">+</span></summary><p>Yes. Save pricing, fixed and variable costs, usage, and targets in a YAML scenario. Compare it with another option, then inspect the output.</p></details>
      <details><summary>What happens when usage grows? <span aria-hidden="true">+</span></summary><p>Use simulations and growth scenarios to test margin and cost limits. Tail-risk checks help expose outcomes that an average alone can hide.</p></details>
      <details><summary>What is available today? <span aria-hidden="true">+</span></summary><p>The open-source local CLI, Codex skill, and CI output are available. Hosted workspaces, saved team history, and approvals are planned.</p></details>
    </div>
  </section>

  <section class="site-shell start-section" id="get-started" data-reveal>
    <div class="start-copy"><p class="eyebrow">04 / Make it yours</p><h2>Bring one<br />real decision.</h2><p>Start with a saved comparison. Then replace the assumptions with your own costs and usage.</p><p class="prerequisite">This source-based quick start requires Git and Go. Release installation is covered in the documentation.</p></div>
    <div class="terminal"><div class="terminal-header"><span>Terminal · Git + Go</span><button type="button" data-copy-command>Copy command</button></div><pre><code data-start-command>{command}</code></pre><div class="terminal-footer"><span class="status-dot" /> Compare two committed examples, locally.</div></div>
  </section>

  <script>
    import { initializeDemo } from "../scripts/demo";
    initializeDemo();
  </script>
</ProductLayout>

<style>
  .eyebrow { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .055em; text-transform: uppercase; line-height: 1.6; }
  .status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding-block: 76px 82px; }
  .hero h1 { margin-top: 20px; font-size: clamp(42px, 4.9vw, 66px); line-height: 1.08; font-weight: 550; letter-spacing: -.065em; }
  .hero h1 span { color: var(--green); }
  .hero-description { max-width: 480px; margin-top: 24px; font-size: 17px; line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .primary-action { display: inline-flex; align-items: center; gap: 32px; min-height: 50px; margin-top: 28px; padding: 0 22px; border-radius: 999px; background: var(--ink); color: white; font-size: 14px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .primary-action:hover { transform: translateY(-3px); box-shadow: 0 10px 20px #20251d15; }
  .hero-note { margin-top: 16px; font-size: 12px; color: var(--muted); }
  .hero-copy { animation: arrive .7s ease-out both; }
  .hero-visual { position: relative; min-height: 390px; overflow: hidden; display: grid; align-content: center; gap: 24px; padding: 58px 28px 50px; border-radius: 28px; background: #242b21; color: #f7f9f3; box-shadow: 0 28px 54px #272e2014; animation: arrive .9s .12s ease-out both; }
  .visual-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff05 1px,transparent 1px),linear-gradient(90deg,#ffffff05 1px,transparent 1px); background-size: 24px 24px; }
  .visual-heading, .visual-caption { position: absolute; left: 28px; right: 28px; font-size: 11px; color: #bac5b0; }
  .visual-heading { top: 24px; display: flex; align-items: center; gap: 8px; }
  .visual-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 14px #c4ee8480; }
  .visual-caption { bottom: 22px; text-align: center; }
  .signal-path { position: absolute; inset: 0; width: 100%; height: 100%; stroke: #43533a; stroke-width: 1; fill: none; }
  .signal-path .path-flow { stroke: var(--accent); stroke-dasharray: 10 28; animation: flow 8s linear infinite; opacity: .6; }
  .signal-node { position: relative; display: flex; align-items: center; gap: 12px; min-height: 76px; padding: 14px; border: 1px solid #5e6a5055; border-radius: 14px; background: #2d3629; }
  .node-one { margin-right: 28px; }.node-two { margin-left: 28px; }.node-three { border-color: #c4ee8460; background: #34482a; margin-right: 12px; }
  .node-icon { display: grid; place-items: center; width: 30px; height: 30px; flex-shrink: 0; border: 1px solid #6c7b5d; border-radius: 9px; color: var(--accent); font-size: 11px; }
  .signal-node small { display: block; margin-bottom: 6px; font-size: 10px; color: #bfccb4; }.signal-node strong { font-size: 13px; font-weight: 550; }.node-tag { margin-left: auto; font-size: 9px; color: #bdcbb1; }
  .section-heading { display: grid; grid-template-columns: 1.1fr 1fr; align-items: end; gap: 48px; margin-bottom: 30px; }
  h2 { margin-top: 12px; font-size: clamp(30px, 3.25vw, 43px); line-height: 1.13; letter-spacing: -.05em; font-weight: 540; text-wrap: balance; }
  .section-heading > p { max-width: 430px; font-size: 15px; line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .demo-shell { overflow: hidden; border: 1px solid #cfd7c4; border-radius: 24px; background: var(--panel); box-shadow: 0 24px 50px #343c2710; }
  .demo-toolbar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 16px 24px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--muted); background: #fafbf6; }.demo-toolbar > div { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 600; }
  .demo-grid { display: grid; grid-template-columns: .8fr 1.2fr; }.demo-inputs { padding: 28px; border-right: 1px solid var(--line); }.demo-inputs h3 { font-size: 17px; font-weight: 600; }
  .demo-presets { display: flex; padding: 4px; gap: 4px; margin-top: 18px; border: 1px solid var(--line); border-radius: 999px; background: #f7f8f2; }.demo-presets button { flex: 1; padding: 8px 10px; min-height: 38px; border: 0; border-radius: 999px; background: transparent; font-size: 11px; color: var(--muted); white-space: nowrap; transition: background .2s, color .2s; }.demo-presets button[aria-pressed=true] { background: var(--ink); color: white; }
  .input-row { margin-top: 28px; }.input-row > div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }.input-row label { font-size: 12px; line-height: 1.5; color: var(--muted); }.input-row output { font-size: 19px; font-weight: 580; font-variant-numeric: tabular-nums; }.input-row input { display: block; width: 100%; min-height: 28px; margin: 10px 0 2px; accent-color: var(--green); cursor: pointer; }.input-row p { font-size: 10px; color: var(--muted); line-height: 1.5; }
  .demo-error { color: var(--risk); font-size: 12px; line-height: 1.5; }.demo-error:not(:empty) { margin-top: 14px; }
  details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; }details summary::-webkit-details-marker { display: none; }details summary > span { font-size: 19px; font-weight: 400; transition: transform .2s; }details[open] summary > span { transform: rotate(45deg); }
  .assumptions { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 10px; }.assumptions summary { min-height: 38px; font-size: 11px; font-weight: 550; }.assumptions p { margin-top: 10px; font-size: 11px; line-height: 1.6; color: var(--muted); }
  .demo-results { padding: 28px; background: linear-gradient(150deg,#f8faf2,white 70%); }.revenue-strip { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 20px; font-size: 12px; color: var(--muted); }.revenue-strip strong { color: var(--ink); font-size: 26px; font-weight: 550; font-variant-numeric: tabular-nums; }
  .results-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); grid-template-rows: auto auto auto; gap: 8px 12px; }.result-card { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: 8px; border: 1px solid var(--line); border-radius: 16px; padding: 18px; background: white; }.candidate { border-color: #bbcdac; background: #f1f6e9; }.option-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }.result-card h3 { font-size: 15px; line-height: 1.4; font-weight: 600; }.result-card dl { display: grid; gap: 16px; margin-top: 12px; }.result-card dt { font-size: 11px; color: var(--muted); }.result-card dd { margin-top: 5px; font-size: 24px; line-height: 1.2; font-weight: 550; font-variant-numeric: tabular-nums; }.result-card dl > div:first-child dd { font-size: 30px; letter-spacing: -.04em; }
  .cost-bars { margin-top: 24px; }.cost-bars > p { margin-bottom: 14px; color: var(--muted); font-size: 11px; }.cost-bars > div { display: grid; grid-template-columns: 64px 1fr; align-items: center; gap: 14px; margin-top: 12px; font-size: 11px; }.bar-track { height: 10px; border-radius: 999px; overflow: hidden; background: #e6ebde; }.bar-track i { display: block; height: 100%; border-radius: 999px; background: #939e85; transition: width .55s cubic-bezier(.2,.8,.2,1); }.bar-track [data-candidate-bar] { background: var(--green); }
  .verdict { display: flex; gap: 12px; margin-top: 26px; padding: 18px; border-radius: 14px; border: 1px solid #cfdec0; background: #e9f1df; }.verdict-icon { display: grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--green); color: white; }.verdict h3 { font-size: 13px; font-weight: 600; line-height: 1.5; }.verdict p { margin-top: 6px; color: var(--muted); font-size: 11px; line-height: 1.6; }.verdict[data-state=risk] { border-color: #e5c5b9; background: #fcf0e9; }.verdict[data-state=risk] .verdict-icon { background: var(--risk); }
  .demo-caption, .no-script { margin-top: 16px; font-size: 11px; line-height: 1.6; color: var(--muted); }.no-script { padding: 0 24px 20px; }
  .how-section { padding-top: 100px; }.steps-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); grid-template-rows: auto auto auto auto; gap: 18px 28px; }.step-card { display: grid; grid-row: span 4; grid-template-rows: subgrid; gap: 18px; padding: 26px 0; border-top: 1px solid #b6c0aa; }.step-number { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #c3d1b6; border-radius: 50%; color: var(--green); font-size: 12px; }.step-card h3 { font-size: 21px; font-weight: 560; line-height: 1.3; letter-spacing: -.025em; text-wrap: balance; }.step-card p { color: var(--muted); font-size: 14px; line-height: 1.7; text-wrap: pretty; }.step-mark { width: fit-content; border: 1px solid #d4dccb; border-radius: 8px; padding: 8px 12px; background: #ecefe5; color: var(--green); font-size: 10px; }
  .delivery-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 24px; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }.delivery-row p { font-size: 13px; color: var(--muted); }.delivery-row > div { display: flex; flex-wrap: wrap; gap: 10px; }.delivery-row span { font-size: 11px; border-radius: 999px; padding: 8px 12px; border: 1px solid var(--line); background: #fcfcf8; }
  .evidence-section { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; padding-top: 100px; align-items: start; }.evidence-copy > p:not(.eyebrow) { max-width: 430px; margin-top: 20px; font-size: 15px; line-height: 1.7; color: var(--muted); text-wrap: pretty; }.evidence-tags { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 22px; }.evidence-tags span { font-size: 10px; color: var(--green); }.questions { border-top: 1px solid #bbc5af; }.questions details { border-bottom: 1px solid #cfd6c5; padding-block: 14px; }.questions summary { min-height: 46px; font-size: 15px; font-weight: 550; line-height: 1.5; }.questions p { padding: 10px 32px 8px 0; font-size: 13px; color: var(--muted); line-height: 1.7; }
  .start-section { display: grid; grid-template-columns: .75fr 1.25fr; gap: 48px; align-items: center; margin-top: 100px; padding: 38px; border-radius: 26px; background: #e7eddc; border: 1px solid #d4ddc8; }.start-copy > p:not(.eyebrow) { margin-top: 18px; font-size: 14px; color: var(--muted); line-height: 1.7; }.start-copy .prerequisite { font-size: 11px !important; }.terminal { overflow: hidden; min-width: 0; border: 1px solid #4d5842; border-radius: 16px; background: #252d21; color: #eef4e6; }.terminal-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 10px 16px; border-bottom: 1px solid #4a553f; font-size: 10px; color: #c1cfb5; }.terminal-header button { border: 1px solid #67785a; border-radius: 7px; background: #36442c; color: #edf6e3; min-height: 38px; padding: 8px 12px; font-size: 10px; line-height: 1.4; }.terminal pre { margin: 0; padding: 24px 20px; font-size: 12px; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }.terminal-footer { display: flex; align-items: center; gap: 8px; padding: 16px; border-top: 1px solid #4a553f; font-size: 10px; color: #c1cfb5; }.terminal-footer .status-dot { background: var(--accent); }
  @keyframes arrive { from { transform: translateY(14px); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
  @keyframes flow { to { stroke-dashoffset: -76; } }
  .is-visible { animation: arrive .7s ease-out both; }
  @media (max-width: 980px) {
    .hero { gap: 28px; padding-block: 52px 64px; }.hero h1 { font-size: 48px; }.hero-description { font-size: 15px; }.hero-visual { padding-inline: 18px; }.node-tag { display: none; }.hero-visual .signal-node { margin-inline: 0; }
    .section-heading { gap: 28px; }.demo-inputs, .demo-results { padding: 22px; }.demo-grid { grid-template-columns: .85fr 1.15fr; }.demo-presets { flex-wrap: wrap; border-radius: 12px; }.result-card { padding: 14px; }.result-card dl > div:first-child dd { font-size: 26px; }.evidence-section { gap: 36px; }.start-section { gap: 28px; padding: 28px; grid-template-columns: .8fr 1.2fr; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 38px; }.hero-copy { max-width: 570px; }.hero h1 { font-size: clamp(38px,7.5vw,54px); }.hero-visual { max-width: 570px; width: 100%; min-height: 330px; padding: 56px 24px 50px; gap: 16px; }.hero-visual .node-one { margin-right: 38px; }.hero-visual .node-two { margin-left: 38px; }.hero-visual .node-three { margin-right: 16px; }.node-tag { display: block; }.signal-node { min-height: 62px; }.section-heading, .evidence-section { grid-template-columns: 1fr; gap: 20px; }.section-heading > p { max-width: 540px; }.demo-grid { grid-template-columns: 1fr; }.demo-inputs { border-right: 0; border-bottom: 1px solid var(--line); }.demo-presets { flex-wrap: nowrap; border-radius: 999px; }.input-row { margin-top: 24px; }.steps-grid { grid-template-columns: 1fr; grid-template-rows: none; gap: 8px; }.step-card { grid-row: auto; grid-template-rows: auto; gap: 14px; }.step-card p { max-width: 550px; }.how-section, .evidence-section { padding-top: 64px; }.start-section { grid-template-columns: 1fr; margin-top: 64px; gap: 28px; }.start-copy h2 br { display: none; }
