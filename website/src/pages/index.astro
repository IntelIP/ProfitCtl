---
import "@fontsource/instrument-sans/latin-500.css";
import "@fontsource/instrument-sans/latin-600.css";
import ProductLayout from "../layouts/ProductLayout.astro";
import DecisionHero from "../components/DecisionHero.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import VideoOverview from "../components/VideoOverview.astro";
import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const example = calculateExample({ users: 1000, requests: 60, price: 20 });
const command = ["git clone \\" , "  " + repoUrl, "cd ProfitCtl", "go run . compare \\", "  examples/hybrid_steady_profit.yml \\", "  examples/hybrid_profit.yml"].join("\n");
const steps = [
  { number: "01", title: "Start with what changes.", detail: "Describe usage, pricing, model calls, and infrastructure. Keep each cost tied to its source and assumptions.", mark: "Usage + rates + pricing" },
  { number: "02", title: "Put the options side by side.", detail: "Compare a feature, model, deployment, or pricing plan. See the effect on revenue, recurring margin, and cost per user.", mark: "Baseline → candidate" },
  { number: "03", title: "Set the limits before you ship.", detail: "Test margin and cost targets, including growth and tail risk. Keep the decision evidence in your review.", mark: "Margins + cost targets" },
];
---

<ProductLayout title="ProfitCTL | Open-Source AI Cost Modeling & Margin Planning" description="Model AI and infrastructure costs, compare product scenarios, and check profit margins before you ship. Try ProfitCTL's interactive example and local CLI.">
  <DecisionHero />

  <section class="site-shell agent-feature" aria-labelledby="agent-feature-title">
    <div>
      <p class="agent-label">ProfitCtl Agent · Source preview</p>
      <h2 id="agent-feature-title">A cost decision you can reopen.</h2>
    </div>
    <div>
      <p>Condere’s deeper research costs more per assessment. Does it produce enough accepted results to pay for itself? Start with the baseline in Codex and answer the open question in Claude Code.</p>
      <a href="/agent/#case">Replay the investigation <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="site-shell calculator-section" id="calculator" data-reveal>
    <details class="calculator-disclosure"><summary>Explore the cost calculator <span aria-hidden="true">+</span></summary>
    <div class="calculator-intro"><h2>Try your own assumptions.</h2><p>Change the price, user count or requests. Both views use the same illustrative rates.</p></div>
    <div class="demo-shell" data-demo>
      <div class="demo-toolbar"><div><span class="status-dot" /> Interactive example</div><span>Sample costs · {exampleMarginTarget}% margin target</span></div>
      <div class="demo-grid">
        <div class="demo-inputs">
          <h3>Your assumptions</h3>
          <div class="demo-presets" role="group" aria-label="Example scenarios">
            <button type="button" data-preset="feature" aria-pressed="true">AI feature</button><button type="button" data-preset="pricing" aria-pressed="false">Pricing</button><button type="button" data-preset="growth" aria-pressed="false">Growth</button>
          </div>
          <div class="input-row"><div><label for="demo-users">Monthly active users</label><output id="users-value" for="demo-users">1,000</output></div><input id="demo-users" type="range" min="100" max="20000" step="100" value="1000" /><p>How many people use the product?</p></div>
          <div class="input-row"><div><label for="demo-requests">AI requests per user</label><output id="requests-value" for="demo-requests">60</output></div><input id="demo-requests" type="range" min="10" max="300" step="10" value="60" /><p>Monthly usage per active user.</p></div>
          <div class="input-row"><div><label for="demo-price">Price per user / month</label><output id="price-value" for="demo-price">$20</output></div><input id="demo-price" type="range" min="5" max="60" step="1" value="20" /><p>The recurring revenue from each user.</p></div>
          <p class="demo-error" data-demo-error role="alert" />
          <details class="assumptions"><summary>Inspect the sample costs <span aria-hidden="true">+</span></summary><div><p>Both options use $400 monthly overhead and $1.50 per user in other variable costs.</p><p>Basic responses cost $0.01 per request. Research-enabled responses cost $0.08 per request.</p><p>This example calculates gross margin. Fees, growth distributions, and full stress tests belong in your CLI scenario.</p></div></details>
        </div>
        <div class="demo-results">
          <div class="revenue-strip"><span>Modeled monthly revenue</span><strong data-revenue>{money(example.revenue)}</strong></div>
          <div class="results-pair">
            <article class="result-card"><p class="option-label">Baseline</p><h3>Basic responses</h3><dl><div><dt>Cost / month</dt><dd data-baseline-cost>{money(example.baseline.cost)}</dd></div><div><dt>Gross margin</dt><dd data-baseline-margin>{percent(example.baseline.margin)}</dd></div><div><dt>Cost / user</dt><dd data-baseline-unit>{money(example.baseline.unitCost, 2)}</dd></div></dl></article>
            <article class="result-card candidate"><p class="option-label">With the feature</p><h3>Research-enabled</h3><dl><div><dt>Cost / month</dt><dd data-candidate-cost>{money(example.candidate.cost)}</dd></div><div><dt>Gross margin</dt><dd data-candidate-margin>{percent(example.candidate.margin)}</dd></div><div><dt>Cost / user</dt><dd data-candidate-unit>{money(example.candidate.unitCost, 2)}</dd></div></dl></article>
          </div>
          <div class="cost-bars" aria-hidden="true"><p>Share of revenue spent</p><div><span>Basic</span><div class="bar-track"><i data-baseline-bar style={`width:${example.baseline.cost / example.revenue * 100}%`} /></div></div><div><span>Research</span><div class="bar-track"><i data-candidate-bar style={`width:${example.candidate.cost / example.revenue * 100}%`} /></div></div></div>
          <div class="verdict" data-verdict data-state="pass" role="status" aria-live="polite" aria-atomic="true"><span class="verdict-icon" aria-hidden="true">↗</span><div><h3 data-verdict-title>The feature clears your margin target.</h3><p data-verdict-detail>Research adds {money(example.addedCost)} per month. The modeled margin meets the {exampleMarginTarget}% target.</p></div></div>
        </div>
      </div>
      <noscript><p class="no-script">These are the default example values. Enable JavaScript to adjust them, or run a scenario in the CLI.</p></noscript>
    </div>
    <p class="demo-caption">An adjustable illustration using sample costs. Your real decisions need your own rates, usage, and evidence.</p>
    </details>
  </section>

  <TerminalDemo />
  <VideoOverview />

  <section class="site-shell how-section" id="how-it-works" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">The workflow</p><h2>From a cost assumption to a decision.</h2></div><p>Use saved scenarios to connect each assumption to a cost, a comparison and a margin you can defend.</p></div>
    <ol class="steps-grid" role="list">
      {steps.map((step) => (
        <li class="step-card">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
          <div class="step-mark">{step.mark}</div>
        </li>
      ))}
    </ol>
    <div class="delivery-row"><p>Run the same scenario in each tool.</p><div><span>Local CLI</span><span>Codex skill</span><span>Pull request checks</span></div></div>
  </section>

  <div class="evidence-band">
  <section class="site-shell evidence-section" data-reveal>
    <div class="evidence-copy">
      <p class="eyebrow">Evidence and assumptions</p>
      <h2>Keep the evidence with the estimate.</h2>
      <p>Trace each estimate to its rates, assumptions and margin targets.</p>
      <ul class="evidence-fields">
        <li>Source + capture date</li>
        <li>Confidence + notes</li>
        <li>Margin + cost targets</li>
      </ul>
    </div>
    <div class="questions">
      <details><summary>Can I use my own costs? <span aria-hidden="true">+</span></summary><p>Yes. Save pricing, fixed and variable costs, usage, and targets in a YAML scenario. Compare it with another option, then inspect the output.</p></details>
      <details><summary>What happens when usage grows? <span aria-hidden="true">+</span></summary><p>Use simulations and growth scenarios to test margin and cost limits. Tail-risk checks help expose outcomes that an average alone can hide.</p></details>
      <details><summary>What is available today? <span aria-hidden="true">+</span></summary><p>The open-source local CLI, Codex skill, and CI output are available. Hosted workspaces, saved team history, and approvals are planned.</p></details>
    </div>
  </section>

  </div>

  <section class="site-shell start-section" id="get-started" data-reveal>
    <div class="start-copy"><p class="eyebrow">Make it yours</p><h2>Bring one<br /> real decision.</h2><p>Start with a saved comparison. Then replace the assumptions with your own costs and usage.</p><a class="primary-action" href={repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a><p>This source-based quick start requires Git and Go. Release installation is covered in the documentation.</p></div>
    <div class="terminal"><div class="terminal-header"><span>Terminal · Git + Go</span><button type="button" data-copy-command>Copy command</button></div><pre><code data-start-command>{command}</code></pre><div class="terminal-footer"><span class="status-dot" /> Compare two committed examples, locally.</div></div>
  </section>

  <script>
    import { initializeDemo } from "../scripts/demo";
    initializeDemo();
  </script>
</ProductLayout>

<style>
  .agent-feature { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: clamp(24px, 6vw, 96px); padding-block: clamp(32px, 5vw, 68px); border-top: 1px solid var(--line); }
  .agent-label { color: var(--green); font-size: 14px; font-weight: 600; }
  .agent-feature h2 { max-width: 16ch; margin-top: 11px; font-size: clamp(33px, 3.6vw, 52px); font-weight: 550; line-height: 1.05; letter-spacing: -.045em; }
  .agent-feature > div + div p { max-width: 49ch; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .agent-feature a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 6px; color: var(--green); font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 700px) { .agent-feature { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
  .eyebrow { margin: 0; color: var(--green); font-size: 14px; font-weight: 600; line-height: 1.5; }
  .status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
  .primary-action { display: inline-flex; align-items: center; gap: 32px; min-height: 50px; margin-top: 28px; padding: 0 22px; border-radius: 999px; background: var(--ink); color: var(--on-ink); font-size: 14px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .primary-action:hover { transform: translateY(-3px); box-shadow: 0 10px 20px #20251d15; }
  h2 { margin-top: 12px; font-size: clamp(38px, 4.3vw, 66px); line-height: 1.04; letter-spacing: -.026em; word-spacing: .045em; font-weight: 540; text-wrap: balance; }
  .section-heading > p { max-width: 52ch; font-size: 17px; line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .demo-shell { overflow: hidden; border: 1px solid light-dark(#cfd7c4, var(--dark-line)); border-radius: 5px; background: var(--panel); }
  .demo-toolbar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 16px 24px; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--muted); background: light-dark(#fafbf6, var(--dark-raised)); }.demo-toolbar > div { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 600; }
  .demo-grid { display: grid; grid-template-columns: .8fr 1.2fr; }.demo-inputs { padding: 28px; border-right: 1px solid var(--line); }.demo-inputs h3 { font-size: 17px; font-weight: 600; }
  .demo-presets { display: flex; padding: 4px; gap: 4px; margin-top: 18px; border: 1px solid var(--line); border-radius: 999px; background: light-dark(#f7f8f2, var(--dark-canvas)); }.demo-presets button { flex: 1; padding: 8px 10px; min-height: 44px; border: 0; border-radius: 999px; background: transparent; font-size: 14px; color: var(--muted); white-space: nowrap; transition: background .2s, color .2s; }.demo-presets button[aria-pressed=true] { background: var(--ink); color: var(--on-ink); }
  .input-row { margin-top: 28px; }.input-row > div { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }.input-row label { font-size: 14px; line-height: 1.5; color: var(--muted); }.input-row output { font-size: 19px; font-weight: 580; font-variant-numeric: tabular-nums; }.input-row input { display: block; width: 100%; min-height: 28px; margin: 10px 0 2px; accent-color: var(--green); cursor: pointer; }.input-row p { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .demo-error { color: var(--risk); font-size: 14px; line-height: 1.5; }.demo-error:not(:empty) { margin-top: 14px; }
  details summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; }details summary::-webkit-details-marker { display: none; }details summary > span { font-size: 19px; font-weight: 400; transition: transform .2s; }details[open] summary > span { transform: rotate(45deg); }
  .assumptions { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 10px; }.assumptions summary { min-height: 44px; font-size: 14px; font-weight: 550; }.assumptions p { margin-top: 10px; font-size: 14px; line-height: 1.6; color: var(--muted); }
  .demo-results { padding: 28px; background: linear-gradient(150deg,light-dark(#f8faf2, var(--dark-raised)),var(--panel) 70%); }.revenue-strip { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 20px; font-size: 14px; color: var(--muted); }.revenue-strip strong { color: var(--ink); font-size: 26px; font-weight: 550; font-variant-numeric: tabular-nums; }
  .results-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); grid-template-rows: auto auto auto; gap: 8px 12px; }.result-card { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: 8px; border: 1px solid var(--line); border-radius: 4px; padding: 18px; background: var(--panel); }.candidate { border-color: light-dark(#bbcdac, var(--dark-line-strong)); background: light-dark(#f1f6e9, var(--dark-raised)); }.option-label { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }.result-card h3 { font-size: 15px; line-height: 1.4; font-weight: 600; }.result-card dl { display: grid; gap: 16px; margin-top: 12px; }.result-card dt { font-size: 14px; color: var(--muted); }.result-card dd { margin-top: 5px; font-size: 24px; line-height: 1.2; font-weight: 550; font-variant-numeric: tabular-nums; }.result-card dl > div:first-child dd { font-size: 30px; letter-spacing: -.04em; }
  .cost-bars { margin-top: 24px; }.cost-bars > p { margin-bottom: 14px; color: var(--muted); font-size: 14px; }.cost-bars > div { display: grid; grid-template-columns: 64px 1fr; align-items: center; gap: 14px; margin-top: 12px; font-size: 14px; }.bar-track { height: 10px; border-radius: 999px; overflow: hidden; background: light-dark(#e6ebde, var(--dark-line)); }.bar-track i { display: block; height: 100%; border-radius: 999px; background: light-dark(#939e85, #777e79); transition: width .55s cubic-bezier(.2,.8,.2,1); }.bar-track [data-candidate-bar] { background: var(--green); }
  .verdict { display: flex; gap: 12px; margin-top: 26px; padding: 18px; border-radius: 4px; border: 1px solid light-dark(#cfdec0, var(--dark-line-strong)); background: light-dark(#e9f1df, var(--dark-raised)); }.verdict-icon { display: grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--green); color: var(--on-ink); }.verdict h3 { font-size: 13px; font-weight: 600; line-height: 1.5; }.verdict p { margin-top: 6px; color: var(--muted); font-size: 14px; line-height: 1.6; }.verdict[data-state=risk] { border-color: light-dark(#e5c5b9, #725747); background: light-dark(#fcf0e9, var(--dark-raised)); }.verdict[data-state=risk] .verdict-icon { background: var(--risk); }
  .demo-caption, .no-script { margin-top: 16px; font-size: 14px; line-height: 1.6; color: var(--muted); }.no-script { padding: 0 24px 20px; }
  .calculator-section { margin-top: 30px; padding-bottom: clamp(64px, 7vw, 110px); }
  .calculator-disclosure { padding-block: 7px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .calculator-disclosure > summary { min-height: 54px; color: var(--green); font-size: 17px; font-weight: 550; }
  .calculator-intro { padding-block: 20px 22px; }
  .calculator-intro h2 { font-size: 27px; }
  .calculator-intro p { margin-top: 10px; color: var(--muted); font-size: 15px; line-height: 1.6; }

  .how-section { padding-bottom: clamp(64px, 8vw, 125px); }
  .section-heading { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(26px, 8vw, 120px); align-items: end; margin-bottom: 34px; }
  .steps-grid { margin: 0; padding: 0; list-style: none; }
  .step-card { display: grid; grid-template-columns: 42px minmax(0,.8fr) minmax(0,1fr); gap: 8px clamp(20px,4vw,70px); align-items: baseline; padding: 26px 0; border-top: 1px solid var(--line-strong); }
  .step-number { grid-column: 1; grid-row: 1 / 3; color: var(--green); font: 500 14px/1.5 ui-monospace, monospace; }
  .step-card h3 { grid-column: 2; grid-row: 1 / 3; color: var(--ink); font-size: clamp(22px,2.3vw,35px); font-weight: 500; line-height: 1.14; letter-spacing: -.021em; word-spacing: .025em; text-wrap: balance; }
  .step-card p, .step-mark { grid-column: 3; }
  .step-card p { max-width: 59ch; color: var(--muted); font-size: 16px; line-height: 1.53; text-wrap: pretty; }
  .step-mark { color: var(--green); font-size: 14px; font-weight: 550; line-height: 1.5; }
  .delivery-row { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: space-between; gap: 12px 26px; padding-block: 19px; border-top: 1px solid var(--line-strong); }
  .delivery-row p { color: var(--muted); font-size: 15px; }
  .delivery-row > div { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .delivery-row span { color: var(--green); font-size: 14px; font-weight: 550; line-height: 1.5; }
  .evidence-band { background: var(--tint); }
  .evidence-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px,7vw,110px); align-items: start; padding-block: clamp(65px,7vw,110px); }
  .evidence-copy > p:not(.eyebrow) { max-width: 44ch; margin-top: 20px; color: var(--muted); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .evidence-fields { display: grid; gap: 5px; margin: 17px 0 0; padding-inline-start: 1.2em; color: var(--green); font-size: 15px; line-height: 1.55; }
  .questions { border-top: 1px solid var(--line-strong); }
  .questions details { border-bottom: 1px solid var(--line-strong); }
  .questions summary { min-height: 69px; color: var(--ink); font-size: clamp(17px,1.45vw,22px); font-weight: 500; line-height: 1.4; }
  .questions p { padding: 0 26px 20px 0; color: var(--muted); font-size: 16px; line-height: 1.6; }
  .start-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px,7vw,105px); align-items: center; padding-block: clamp(70px,9vw,148px); }
  .start-copy > p:not(.eyebrow) { margin-top: 18px; color: var(--muted); font-size: 16px; line-height: 1.55; }
  .start-copy > p:last-child { font-size: 14px; }
  .terminal { min-width: 0; overflow: hidden; border-radius: 5px; border: 1px solid light-dark(#3e6351, var(--dark-line)); background: var(--terminal-surface); color: light-dark(#eef6ed, var(--dark-text)); }
  .terminal-header, .terminal-footer { display: flex; align-items: center; gap: 8px; padding: 10px 17px; color: light-dark(#c8d9cc, var(--dark-muted)); font-size: 13px; line-height: 1.5; }
  .terminal-header { justify-content: space-between; flex-wrap: wrap; border-bottom: 1px solid var(--terminal-rule); }
  .terminal-header button { min-height: 44px; padding: 6px 12px; border: 1px solid light-dark(#698574, var(--dark-line-strong)); border-radius: 5px; background: light-dark(#244337, var(--dark-raised)); color: light-dark(#f0f6ee, var(--dark-text)); font-size: 14px; }
  .terminal pre { margin: 0; padding: 22px 17px; font-size: 14px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .terminal-footer { padding-block: 14px; border-top: 1px solid var(--terminal-rule); }
  .terminal-footer .status-dot { background: #c5ed8c; }
  @keyframes arrive { from { transform: translateY(14px); opacity: .4; } to { transform: translateY(0); opacity: 1; } }
  .is-visible { animation: arrive .7s ease-out both; }
  @media (max-width: 980px) {
    .demo-inputs, .demo-results { padding: 22px; }
    .demo-grid { grid-template-columns: .85fr 1.15fr; }
    .demo-presets { flex-wrap: wrap; }
  }
  @media (max-width: 760px) {
    .section-heading, .evidence-section, .start-section, .demo-grid { grid-template-columns: minmax(0,1fr); }
    .section-heading { gap: 16px; }
    .step-card { grid-template-columns: 27px minmax(0,1fr); gap: 7px 13px; }
    .step-number, .step-card h3 { grid-row: 1; }
    .step-card p, .step-mark { grid-column: 2; }
    .step-card h3 { font-size: 25px; }
    .demo-inputs { border-right: 0; border-bottom: 1px solid var(--line); }
    .start-copy h2 br { display: none; }
  }
  @media (max-width: 440px) {
    .demo-toolbar { padding: 12px 14px; }
    .demo-inputs, .demo-results { padding: 18px 14px; }
    .result-card { padding: 12px; }
    .result-card h3 { font-size: 14px; }
    .result-card dl > div:first-child dd { font-size: 23px; }
    .result-card dd, .revenue-strip strong { font-size: 21px; }
    .verdict { padding: 14px; }
  }
</style>
