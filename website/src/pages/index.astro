---
import ProductLayout from "../layouts/ProductLayout.astro";

const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const providers = [
  { name: "Workers", logo: "/logos/profitctl/cloudflare-workers.svg", monthly: "$94k", margin: "76.5%", state: "pass", stateLabel: "Within budget" },
  { name: "Cloud Run", logo: "/logos/profitctl/google-cloud.svg", monthly: "$123k", margin: "69.3%", state: "pass", stateLabel: "Within budget" },
  { name: "Vercel", logo: "/logos/profitctl/vercel.svg", monthly: "$168k", margin: "58.0%", state: "watch", stateLabel: "Over budget" },
];
const heroMetrics = [
  { label: "Monthly cost", value: "$94k", detail: "lowest sample cost" },
  { label: "Gross margin", value: "76.5%", detail: "target ≥ 60%" },
  { label: "Budget headroom", value: "$56k", detail: "below $150k / month" },
  { label: "Cost / active user", value: "$9.40", detail: "target ≤ $18" },
];
const evidenceCards = [
  {
    badge: "AI features",
    title: "Price a feature before launch.",
    detail: "Model token, API, and research costs. See what each request leaves toward your margin.",
    items: ["Model and API usage", "Cost per active user", "Evidence behind each assumption"],
    action: "Read the simulation guide",
    href: repoUrl + "/blob/main/docs/QUICK_START.md",
  },
  {
    badge: "Pricing",
    title: "Choose a plan that pays for itself.",
    detail: "Compare subscriptions and usage pricing against the same cost model.",
    items: ["Revenue and payment fees", "Plan mix and recurring margin", "Side-by-side scenario output"],
    action: "Read a pricing comparison",
    href: repoUrl + "/blob/main/benchmark_scenarios/reports/open_core_tiered_vs_mix.md",
  },
  {
    badge: "Growth risk",
    title: "Find where higher usage breaks margin.",
    detail: "Stress your assumptions before growth turns a profitable feature into a cost problem.",
    items: ["Growth and stress scenarios", "Tail-risk margin checks", "Explicit limits for acceptable costs"],
    action: "Browse benchmark scenarios",
    href: repoUrl + "/blob/main/benchmark_scenarios/README.md",
  },
];
const standards = [
  { label: "Provenance", detail: "Every cost line has a source, capture date, and note." },
  { label: "Confidence", detail: "Low, medium, or high based on the available evidence." },
  { label: "Covenants", detail: "Check margin, tail risk, and user cost against explicit targets." },
  { label: "Decision artifact", detail: "Share assumptions, tables, and charts with your decision." },
  { label: "Evidence checks", detail: "The standards judge flags claims without trustworthy evidence." },
];
const productSurfaces = [
  {
    status: "Open source now",
    title: "CLI",
    detail: "Compare choices and test assumptions on your machine.",
    items: ["compare, simulate, validate", "Scenario templates", "JSON output", "Cost model standards"],
  },
  {
    status: "Open source now",
    title: "Codex skill",
    detail: "Bring cost evidence into agent decisions about your code.",
    items: ["Architecture comparisons", "Assumption-aware output", "Temporary scenario edits", "Evidence from your repository"],
  },
  {
    status: "Open source now",
    title: "CI / PR check",
    detail: "Use JSON output to check margins before changes land.",
    items: ["Recurring margin checks", "Covenant failures in pull requests", "Saved scenario files", "Decision evidence in reviews"],
  },
  {
    status: "Hosted later",
    title: "Team workflow",
    detail: "Keep team history, approvals, and calibration in one place.",
    items: ["Workspaces and saved runs", "Policies and approvals", "Calibration connectors", "Roles and single sign-on"],
  },
];
const footerLinks = [
  { label: "GitHub", href: repoUrl, external: true },
  { label: "Get started", href: "#get-started" },
];
const quickStartCommand = [
  "git clone " + repoUrl + ".git",
  "cd ProfitCtl",
  "go run . compare examples/hybrid_steady_profit.yml examples/hybrid_profit.yml",
].join("\n");
---

<ProductLayout
  title="ProfitCtl | AI and SaaS Cost & Profitability CLI"
  description="ProfitCtl helps AI-native teams compare infrastructure, model, tool, pricing, and product-cost decisions before spend becomes real."
>
  <main class="profitctl-page">
    <header class="site-header">
      <div class="site-header-inner">
          <a href="/" class="brand" aria-label="ProfitCtl home">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>ProfitCtl</span>
        </a>
        <nav class="site-nav" aria-label="ProfitCtl navigation">
          <a href="#compare">Compare</a>
          <a href="#demos">Examples</a>
          <a href="#standards">Standards</a>
          <a href="#open-core">Open core</a>
        </nav>
        <a class="nav-button" href={repoUrl} rel="noopener noreferrer" target="_blank">
          <img src="/logos/profitctl/github.svg" alt="" loading="eager" decoding="async" />
          GitHub
        </a>
      </div>
    </header>

    <section class="hero-shell">
      <div class="hero-copy">
        <h1>Compare spend before it ships.</h1>
        <p>Compare infrastructure, AI, and pricing choices against the margins your business needs.</p>
        <div class="hero-actions">
          <a class="primary-action" href="#get-started">Get started</a>
          <a class="secondary-action" href="#demos">Explore use cases</a>
        </div>
        <p class="hero-note">MIT licensed. Open source. Runs locally.</p>
      </div>

      <article class="decision-board" id="compare" aria-label="ProfitCtl compare preview">
        <div class="command-strip">
          <span>Infrastructure · monthly comparison</span>
          <strong>Illustrative example</strong>
        </div>
        <div class="metrics-strip">
          {heroMetrics.map((metric) => (
            <article><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.detail}</small></article>
          ))}
        </div>
        <div class="chart-shell">
          <div class="chart-header"><div><p>One scenario, three options</p><h2>Compare cost and margin.</h2></div></div>
          <table class="comparison-table" aria-label="Illustrative monthly infrastructure costs">
            <thead><tr><th scope="col">Provider</th><th scope="col">Cost / month</th><th scope="col">Gross margin</th></tr></thead>
            <tbody>
              {providers.map((provider) => (
                <tr>
                  <th scope="row"><div class="provider-id">
                    <img src={provider.logo} alt="" width="24" height="24" decoding="async" />
                    <div><span>{provider.name}</span><small class={provider.state}>{provider.stateLabel}</small></div>
                  </div></th>
                  <td>{provider.monthly}</td><td>{provider.margin}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="chart-note">Sample inputs: 10k active users, $40 revenue per user, $150k monthly budget. Costs are illustrative.</p>
        </div>
        <div class="recommendation-bar"><div class="recommendation-copy">
          <strong>Workers has the lowest sample cost.</strong>
          <p>$74k less per month than Vercel in this illustration.</p>
        </div></div>
      </article>
    </section>

    <section class="evidence-section" id="demos">
      <div class="section-copy">
        <h2>Decisions you can model.</h2>
        <p>Start with the question your business needs to answer.</p>
      </div>
      <div class="evidence-band">
        {evidenceCards.map((card) => (
          <article class="evidence-card">
            <span class="card-badge">{card.badge}</span>
            <h3>{card.title}</h3>
            <p>{card.detail}</p>
            <ul>{card.items.map((item) => <li>{item}</li>)}</ul>
            <a href={card.href} rel="noopener noreferrer" target="_blank">{card.action}<span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="standards-section" id="standards">
      <div class="section-copy">
        <h2>Standards make the math trustworthy.</h2>
        <p>Every answer includes provenance, confidence, assumptions, and covenant checks.</p>
      </div>

      <div class="standards-grid">
        {
          standards.map((standard) => (
            <article>
              <span class="standard-icon" aria-hidden="true" />
              <h3>{standard.label}</h3>
              <p>{standard.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="open-core-section" id="open-core">
      <div class="section-copy">
        <h2>Use it where you make decisions.</h2>
        <p>Start locally. Bring your scenarios into agent work and pull request checks. Hosted team workflows are planned.</p>
      </div>
      <div class="core-map">
        {productSurfaces.map((surface) => (
          <article class={"surface-card " + (surface.status === "Hosted later" ? "later" : "current")}>
            <span class="side-label">{surface.status}</span>
            <h3>{surface.title}</h3>
            <p>{surface.detail}</p>
            <ul>{surface.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="final-cta" id="get-started">
      <div>
        <span class="section-chip">First step</span>
        <h2>Run your first comparison.</h2>
        <p>Requires Git and Go. Run the saved examples in your terminal.</p>
        <pre class="start-command"><code>{quickStartCommand}</code></pre>
      </div>
      <div class="cta-actions">
        <a href={repoUrl + "/blob/main/docs/INSTALL.md"} rel="noopener noreferrer" target="_blank">Install a release</a>
        <a class="cta-secondary" href={repoUrl + "/tree/main/examples"} rel="noopener noreferrer" target="_blank">Browse examples</a>
      </div>
    </section>

    <footer class="product-footer">
      <div class="product-footer-inner">
        <a href="/" class="brand" aria-label="ProfitCtl home">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>ProfitCtl</span>
        </a>
        <nav aria-label="ProfitCtl footer">
          {
            footerLinks.map((link) => (
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined} target={link.external ? "_blank" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <p>Copyright (c) 2026 ProfitCtl contributors.</p>
      </div>
    </footer>
  </main>
</ProductLayout>

<style>
  :global(html) {
    background: hsl(42 38% 95%);
    color-scheme: light;
  }

  .profitctl-page {
    --pc-bg: 42 38% 95%;
    --pc-bg-2: 34 34% 98%;
    --pc-panel: 0 0% 100%;
    --pc-panel-2: 40 38% 97%;
    --pc-panel-3: 45 26% 92%;
    --pc-line: 38 18% 83%;
    --pc-line-strong: 34 18% 74%;
    --pc-text: 30 14% 11%;
    --pc-muted: 28 10% 38%;
    --pc-subtle: 30 10% 56%;
    --pc-profit: 84 83% 47%;
    --pc-profit-deep: 83 72% 34%;
    --pc-copper: 32 77% 56%;
    --pc-risk: 22 90% 58%;
    --pc-blue: 217 63% 55%;
    --pc-shadow: 30 18% 30%;
    min-height: 100vh;
    overflow-x: clip;
    background:
      radial-gradient(circle at top left, hsl(var(--pc-profit) / 0.14), transparent 24rem),
      radial-gradient(circle at 90% 16%, hsl(var(--pc-copper) / 0.12), transparent 28rem),
      linear-gradient(180deg, hsl(var(--pc-bg-2)) 0%, hsl(var(--pc-bg)) 52%, hsl(40 30% 93%) 100%);
    color: hsl(var(--pc-text));
  }

  .profitctl-page :is(h1, h2, h3, p, dl, dd) {
    margin: 0;
  }

  .profitctl-page :is(section, article, div) {
    min-width: 0;
  }

  .profitctl-page a:focus-visible {
    outline: 3px solid hsl(var(--pc-profit-deep));
    outline-offset: 4px;
  }

  .hero-shell,
  .site-header-inner,
  .product-footer-inner,
  .evidence-section,
  .standards-section,
  .open-core-section,
  .final-cta {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 74px;
    border-bottom: 1px solid hsl(var(--pc-line) / 0.95);
    background: hsl(var(--pc-bg-2) / 0.86);
    backdrop-filter: blur(18px);
    width: 100%;
    padding-inline: 0;
  }

  .site-header-inner,
  .product-footer-inner {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    height: 100%;
  }

  .brand,
  .site-nav,
  .nav-button,
  .hero-actions,
  .product-footer,
  .product-footer nav {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 12px;
    color: hsl(var(--pc-text));
    font-size: 18px;
    font-weight: 760;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 8px;
    background: hsl(var(--pc-profit) / 0.22);
    color: hsl(var(--pc-profit-deep));
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
  }

  .site-nav {
    justify-content: center;
    gap: 32px;
  }

  .site-nav a,
  .product-footer a {
    color: hsl(var(--pc-muted));
    font-size: 13px;
    font-weight: 580;
    text-decoration: none;
  }

  .site-nav a:hover,
  .product-footer nav a:hover {
    color: hsl(var(--pc-text));
  }

  .nav-button,
  .primary-action,
  .secondary-action,
  .evidence-card a,
  .final-cta a,
  .recommendation-bar a {
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-button {
    gap: 10px;
    justify-self: end;
    border: 1px solid hsl(var(--pc-line-strong));
    background: hsl(var(--pc-panel));
    color: hsl(var(--pc-text));
    padding: 9px 14px;
    box-shadow: 0 12px 28px hsl(var(--pc-shadow) / 0.06);
  }

  .nav-button img {
    width: 17px;
    height: 17px;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 40px;
    align-items: start;
    padding: 56px 0 48px;
    min-height: auto;
  }

  .hero-copy h1 {
    max-width: 520px;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 520;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-family: "Instrument Sans", sans-serif;
  }

  .hero-copy h1::selection,
  .section-copy h2::selection {
    background: hsl(var(--pc-profit) / 0.24);
  }

  .hero-copy p {
    max-width: 470px;
    margin-top: 20px;
    color: hsl(var(--pc-muted));
    font-size: 18px;
    line-height: 1.55;
  }

  .hero-actions {
    gap: 14px;
    margin-top: 28px;
  }

  .primary-action,
  .secondary-action,
  .final-cta a {
    min-height: 48px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .primary-action {
    background: hsl(var(--pc-text));
    color: hsl(var(--pc-panel));
    box-shadow: 0 18px 38px hsl(var(--pc-shadow) / 0.12);
  }

  .secondary-action {
    border: 1px solid hsl(var(--pc-line-strong));
    background: hsl(var(--pc-panel));
    color: hsl(var(--pc-text));
  }

  .decision-board,
  .evidence-card,
  .standards-grid article,
  .surface-card,
  .final-cta {
    border: 1px solid hsl(var(--pc-line));
    background: hsl(var(--pc-panel) / 0.94);
    box-shadow: 0 22px 52px hsl(var(--pc-shadow) / 0.08);
  }

  .decision-board {
    overflow: hidden;
    border-radius: 22px;
    max-width: 720px;
    width: 100%;
    min-width: 0;
    justify-self: stretch;
    scroll-margin-top: 120px;
  }

  .command-strip {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid hsl(var(--pc-line));
    padding: 10px 18px;
    color: hsl(var(--pc-muted));
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    align-items: center;
    flex-wrap: wrap;
  }

  .command-strip strong {
    color: hsl(var(--pc-text));
    font-weight: 760;
    white-space: nowrap;
  }

  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding: 14px 18px 0;
  }

  .metrics-strip article {
    border: 1px solid hsl(var(--pc-line));
    border-radius: 14px;
    background: hsl(var(--pc-panel-2));
    padding: 11px 13px;
    display: grid;
    grid-template-rows: minmax(28px, auto) auto auto;
  }

  .metrics-strip span,
  .recommendation-copy strong,
  .card-badge,
  dt,
  .side-label {
    color: hsl(var(--pc-subtle));
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .metrics-strip strong {
    display: block;
    margin-top: 6px;
    font-size: 29px;
    font-weight: 750;
    line-height: 1;
  }

  .metrics-strip small {
    display: block;
    margin-top: 6px;
    color: hsl(var(--pc-profit-deep));
    font-size: 11px;
    font-weight: 650;
  }

  .chart-shell {
    padding: 16px 18px 0;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: start;
    flex-direction: column;
    margin-bottom: 12px;
  }

  .chart-header p {
    color: hsl(var(--pc-muted));
    font-size: 13px;
  }

  .chart-header h2 {
    margin-top: 4px;
    font-size: 18px;
    font-weight: 720;
  }

  .recommendation-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    align-items: center;
    margin: 14px 18px 18px;
    border: 1px solid hsl(var(--pc-line));
    border-radius: 16px;
    background:
      linear-gradient(90deg, hsl(var(--pc-profit) / 0.12), transparent 36%),
      hsl(var(--pc-panel-2));
    padding: 10px 14px;
  }

  .recommendation-copy p,
  .section-copy p,
  .standards-grid p,
  .surface-card li,
  .final-cta p {
    color: hsl(var(--pc-muted));
    font-size: 13px;
    line-height: 1.55;
  }

  .recommendation-copy p {
    margin-top: 6px;
  }

  .recommendation-bar a,
  .evidence-card a {
    color: hsl(var(--pc-text));
  }

  .evidence-band,
  .standards-grid,
  .core-map {
    display: grid;
    gap: 16px;
  }

  .evidence-band {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto 34px auto auto auto;
    margin-top: 24px;
    scroll-margin-top: 96px;
  }

  .evidence-card {
    display: grid;
    align-content: start;
    gap: 14px;
    border-radius: 20px;
    padding: 16px;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }

  .evidence-card .card-badge { grid-row: 1; }
  .evidence-card h3 { grid-row: 2; }
  .evidence-card > a { grid-row: 6; }

  .card-badge {
    display: inline-flex;
    width: fit-content;
    border-radius: 999px;
    border: 1px solid hsl(var(--pc-line));
    background: hsl(var(--pc-panel-2));
    padding: 6px 9px;
    letter-spacing: 0;
    text-transform: none;
  }

  .evidence-card h3 {
    font-size: 17px;
    font-weight: 620;
    line-height: 1.24;
  }

  dt {
    letter-spacing: 0;
  }

  dd {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 700;
  }

  .evidence-card a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .section-copy {
    max-width: 740px;
  }

  .section-copy h2 {
    font-size: clamp(32px, 3.6vw, 46px);
    font-weight: 540;
    line-height: 1.12;
  }

  .section-copy p {
    margin-top: 14px;
    font-size: 16px;
  }

  .standards-section,
  .open-core-section {
    margin-top: 0;
    padding: 64px 0 0;
    scroll-margin-top: 96px;
  }

  .standards-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 22px;
  }

  .standards-grid article {
    border-radius: 18px;
    padding: 16px;
  }

  .standard-icon {
    display: inline-block;
    width: 34px;
    height: 34px;
    border: 1px solid hsl(var(--pc-line-strong));
    border-radius: 12px;
    background:
      linear-gradient(135deg, hsl(var(--pc-panel)), hsl(var(--pc-panel-2))),
      hsl(var(--pc-panel));
    position: relative;
  }

  .standard-icon::after {
    position: absolute;
    inset: 10px;
    border-radius: 999px;
    background: hsl(var(--pc-text));
    content: "";
    opacity: 0.12;
  }

  .standards-grid h3 {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 690;
  }

  .standards-grid p {
    margin-top: 10px;
  }

  .core-map {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto;
    row-gap: 12px;
    align-items: stretch;
    margin-top: 24px;
  }

  .surface-card {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    align-content: start;
    border-radius: 20px;
    padding: 18px;
    border: 1px solid hsl(var(--pc-line));
    background: hsl(var(--pc-panel) / 0.94);
    box-shadow: 0 22px 52px hsl(var(--pc-shadow) / 0.08);
  }

  .surface-card.current {
    background:
      linear-gradient(180deg, hsl(var(--pc-profit) / 0.08), transparent 30%),
      hsl(var(--pc-panel) / 0.96);
  }

  .surface-card.later {
    background:
      linear-gradient(180deg, hsl(var(--pc-blue) / 0.08), transparent 30%),
      hsl(var(--pc-panel) / 0.96);
  }

  .surface-card h3 {
    margin-top: 0;
    font-size: 21px;
    font-weight: 690;
    line-height: 1.25;
  }

  .surface-card p {
    margin-top: 0;
    color: hsl(var(--pc-muted));
    font-size: 13px;
    line-height: 1.5;
  }

  .surface-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .surface-card li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 10px;
  }

  .surface-card li::before {
    position: absolute;
    left: 0;
