---
import "@fontsource/instrument-sans";

export interface Props {
  title: string;
  description: string;
  pageType?: "product" | "docs";
}

const { title, description, pageType = "product" } = Astro.props;
const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const canonicalOrigin = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, canonicalOrigin);
const imageURL = new URL("/images/profitctl-social.jpg", canonicalOrigin);
const schema = pageType === "docs" ? {
  "@context": "https://schema.org", "@type": "TechArticle", headline: title,
  description, url: canonicalURL.href, image: imageURL.href,
  author: { "@type": "Organization", name: "ProfitCtl contributors", url: repoUrl },
} : {
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "ProfitCtl",
  applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux, Windows",
  description, url: canonicalURL.href, image: imageURL.href,
  license: repoUrl + "/blob/main/LICENSE", downloadUrl: repoUrl + "/releases",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23090B05'/%3E%3Crect x='12' y='12' width='40' height='40' rx='8' fill='none' stroke='%23B8FF18' stroke-width='4'/%3E%3Ctext x='32' y='41' text-anchor='middle' font-family='Arial,sans-serif' font-size='30' font-weight='700' fill='%23B8FF18'%3EP%3C/text%3E%3C/svg%3E";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ProfitCtl" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ProfitCtl" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProfitCtl: Know your AI costs. Protect your margin." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <meta name="twitter:image:alt" content="ProfitCtl: Know your AI costs. Protect your margin." />
    <meta name="theme-color" content="#B8FF18" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-shell site-header-inner">
        <a href="/" class="brand" aria-label="ProfitCtl home"><span class="brand-mark" aria-hidden="true">P</span><span>ProfitCtl</span></a>
        <nav class="site-nav" aria-label="Main navigation"><a href="/#demo">Demo</a><a href="/#how-it-works">How it works</a></nav>
        <a class="header-action" href="/#get-started">Get started <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div><a href="/" class="brand" aria-label="ProfitCtl home"><span class="brand-mark" aria-hidden="true">P</span><span>ProfitCtl</span></a><p>Cost decisions, before commitment.</p></div>
        <nav aria-label="Footer navigation"><a href="/docs/">Documentation</a><a href={repoUrl} rel="noopener noreferrer" target="_blank">Source code <span aria-hidden="true">↗</span></a></nav>
        <p class="footer-note">MIT licensed · © 2026 ProfitCtl contributors</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: "Instrument Sans", system-ui, sans-serif;
    color-scheme: light;
    --page: #f5f5ee;
    --panel: #ffffff;
    --ink: #20251d;
    --muted: #62685b;
    --line: #dce0d4;
    --accent: #c4ee84;
    --green: #426526;
    --risk: #9e422e;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    color: var(--ink);
    background: var(--page);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  a,
  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  :where(h1, h2, h3, p, dl, dd, figure) { margin: 0; }
  a { color: inherit; }
  button { cursor: pointer; }
  :where(a, button, input, summary):focus-visible { outline: 3px solid var(--green); outline-offset: 5px; }
  .site-shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  section[id], article[id] { scroll-margin-top: 120px; }
  .site-header { position: sticky; top: 0; z-index: 20; background: #f5f5eef0; backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .site-header-inner { min-height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; text-decoration: none; font-weight: 650; font-size: 18px; letter-spacing: -.03em; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--accent); color: var(--green); font-size: 22px; }
  .site-nav { display: flex; align-items: center; gap: 26px; }
  .site-nav a, .site-footer nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; text-decoration: none; color: var(--muted); }
  .site-nav a:hover, .site-footer nav a:hover { color: var(--ink); }
  .header-action { justify-self: end; display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 42px; padding: 0 17px; border-radius: 999px; background: var(--ink); color: white; font-size: 13px; text-decoration: none; transition: transform .2s; }
  .header-action:hover { transform: translateY(-2px); }
  .site-footer { margin-top: 88px; padding: 36px 0; border-top: 1px solid var(--line); }
  .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; }
  .footer-inner p { margin-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 24px; }
  .footer-inner .footer-note { grid-column: 1 / -1; margin-top: 0; }
  .skip-link { position: fixed; left: 16px; top: 8px; z-index: 50; padding: 12px 18px; background: var(--ink); color: white; border-radius: 8px; transform: translateY(-180%); }
  .skip-link:focus { transform: translateY(0); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .site-shell { width: calc(100% - 32px); }
    .site-header-inner { padding-block: 10px; grid-template-columns: 1fr auto; gap: 5px 12px; }
    .site-nav { grid-row: 2; grid-column: 1 / -1; gap: 24px; }
    .site-nav a { min-height: 30px; }
    .footer-inner { grid-template-columns: 1fr; }
    .site-footer { margin-top: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>
