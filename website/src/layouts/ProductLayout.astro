---
import "@fontsource/instrument-sans";
import ThemeControl from "../components/ThemeControl.astro";
import initializeColorTheme from "../scripts/color-theme.js?raw";

export interface Props {
  title: string;
  description: string;
  pageType?: "product" | "docs" | "agent" | "error";
}

const { title, description, pageType = "product" } = Astro.props;
const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
const openPanelClientId = import.meta.env.PUBLIC_OPENPANEL_CLIENT_ID?.trim();
const canonicalOrigin = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, canonicalOrigin);
const imageURL = new URL("/images/profitctl-social-calculator.jpg", canonicalOrigin);
const iconURL = new URL("/icons/profitctl-192.png", canonicalOrigin);
const developer = { "@type": "Person", name: "Hudson Aikins" };
const publisher = { "@type": "Organization", name: "IntelIP", url: "https://github.com/IntelIP" };
const siteSchema = {
  "@context": "https://schema.org", "@type": "WebSite", name: "ProfitCTL",
  url: new URL("/", canonicalOrigin).href,
};
const schema = pageType !== "product" ? {
  "@context": "https://schema.org", "@type": "TechArticle", headline: title,
  description, url: canonicalURL.href, image: imageURL.href,
  author: developer, publisher,
} : {
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "ProfitCTL",
  applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux, Windows",
  description, url: canonicalURL.href, image: [iconURL.href, imageURL.href],
  license: repoUrl + "/blob/main/LICENSE", downloadUrl: repoUrl + "/releases",
  author: developer, publisher, sameAs: repoUrl,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=calculator" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=calculator" />
    <link rel="shortcut icon" href="/favicon.ico?v=calculator" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=calculator" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="IntelIP and Hudson Aikins" />
    <meta name="robots" content={pageType === "error" ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ProfitCTL" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProfitCTL: Know your AI costs. Protect your margin." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <meta name="twitter:image:alt" content="ProfitCTL: Know your AI costs. Protect your margin." />
    <meta name="theme-color" content="#f5f5ee" media="(prefers-color-scheme: light)" data-theme-color="light" />
    <meta name="theme-color" content="#080a09" media="(prefers-color-scheme: dark)" data-theme-color="dark" />
    <script is:inline set:html={initializeColorTheme}></script>
    {pageType !== "error" && <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
    />}
    {pageType === "product" && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(siteSchema).replaceAll("<", "\\u003c")}
      />
    )}
    {import.meta.env.PROD && openPanelClientId && (
      <script is:inline data-openpanel-init define:vars={{ openPanelClientId }}>
        (() => {
          if (
            !["profitctl.com", "www.profitctl.com"].includes(location.hostname) ||
            navigator.doNotTrack === "1" ||
            navigator.globalPrivacyControl === true ||
            window.op
          ) return;

          window.op = function () {
            (window.op.q = window.op.q || []).push(Array.from(arguments));
          };
          window.op("init", {
            clientId: openPanelClientId,
            trackScreenViews: true,
            trackOutgoingLinks: true,
            trackAttributes: false,
          });

          const script = document.createElement("script");
          script.src = "https://openpanel.dev/op1.js";
          script.async = true;
          document.head.appendChild(script);
        })();
      </script>
    )}
  </head>
  <body class:list={[{ "product-page": pageType !== "docs" }]}>
    <script>
      import { initializeCampaignMeasurement } from "../scripts/campaign-measurement";
      initializeCampaignMeasurement();
    </script>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-shell site-header-inner">
        <a href="/" class="brand" aria-label="ProfitCTL home"><img src="/favicon.svg?v=calculator" width="32" height="32" alt="" />ProfitCTL</a>
        <nav class="product-nav" aria-label="Main navigation">
          <a href="/agent/" aria-current={pageType === "agent" ? "page" : undefined}>Agent</a>
          <a href="/docs/" aria-current={pageType === "docs" ? "page" : undefined}>Docs</a>
          <a class="repo-link" href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <ThemeControl />
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div><a href="/" class="brand" aria-label="ProfitCTL home"><img src="/favicon.svg?v=calculator" width="32" height="32" alt="" />ProfitCTL</a><p>Cost decisions, before commitment.</p></div>
        <nav aria-label="Footer navigation"><a href="/agent/">ProfitCtl Agent</a><a href="/#watch">Video overview</a><a href="/docs/">Documentation</a><a href={repoUrl} rel="noopener noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a></nav>
        <p class="footer-note">Developed by <a href="https://github.com/IntelIP">IntelIP</a> and Hudson Aikins.<br />MIT licensed · © 2026 ProfitCTL contributors</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: "Instrument Sans", system-ui, sans-serif;
    color-scheme: light dark;
    --dark-canvas: #080a09;
    --dark-surface: #111412;
    --dark-raised: #191c1a;
    --dark-text: #eff2ef;
    --dark-muted: #b9bfba;
    --dark-line: #333835;
    --dark-line-strong: #656d67;
    --page: light-dark(#f5f5ee, var(--dark-canvas));
    --panel: light-dark(#ffffff, var(--dark-surface));
    --ink: light-dark(#20251d, var(--dark-text));
    --on-ink: light-dark(#ffffff, var(--dark-canvas));
    --muted: light-dark(#62685b, var(--dark-muted));
    --line: light-dark(#dce0d4, var(--dark-line));
    --line-strong: light-dark(#9aa99c, var(--dark-line-strong));
    --tint: light-dark(#eef4ec, var(--dark-raised));
    --accent: light-dark(#c4ee84, #b6ef8b);
    --green: light-dark(#426526, #afe18e);
    --risk: light-dark(#9e422e, #ffba97);
    --terminal-surface: light-dark(#102c24, var(--dark-canvas));
    --terminal-rule: light-dark(#4b6859, var(--dark-line));
    --terminal-accent: light-dark(#cbf397, #c3fa91);
  }
  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    min-height: 100vh;
    color: var(--ink);
    background: var(--page);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  a,
  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  :where(h1, h2, h3, p, dl, dd, figure) { margin: 0; }
  a { color: inherit; }
  button { cursor: pointer; }
  :where(a, button, input, summary):focus-visible { outline: 3px solid var(--green); outline-offset: 5px; }
  .site-shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  section[id], article[id] { scroll-margin-top: 120px; }
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--page) 94%, transparent); backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .site-header-inner { min-height: 76px; display: flex; align-items: center; gap: clamp(8px,1.6vw,24px); }
  .site-header-inner .product-nav { margin-inline-start: auto; }
  .site-header-inner .product-nav + [data-theme-control] { margin-inline-start: 0; }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; width: fit-content; text-decoration: none; font-weight: 650; font-size: 20px; letter-spacing: -.03em; }
  .brand img { flex: none; }
  .site-footer nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; text-decoration: none; color: var(--muted); }
  .site-footer nav a:hover { color: var(--ink); }
  .site-footer { margin-top: 88px; padding: 36px 0; border-top: 1px solid var(--line); }
  .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: start; }
  .footer-inner p { margin-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 24px; }
  .footer-inner .footer-note { grid-column: 1 / -1; margin-top: 0; }
  .skip-link { position: fixed; left: 16px; top: 8px; z-index: 50; padding: 12px 18px; background: var(--ink); color: var(--on-ink); border-radius: 8px; transform: translateY(-180%); }
  .skip-link:focus { transform: translateY(0); }
  .product-page {
    --page: light-dark(#fdfefb, var(--dark-canvas));
    --panel: light-dark(#fff, var(--dark-surface));
    --ink: light-dark(#15291f, var(--dark-text));
    --on-ink: light-dark(#fff, var(--dark-canvas));
    --green: light-dark(#275e40, #b7ed93);
    --muted: light-dark(#505e53, var(--dark-muted));
    --line: light-dark(#d7e0d5, var(--dark-line));
    --line-strong: light-dark(#9aa99c, var(--dark-line-strong));
    --tint: light-dark(#eef4ec, var(--dark-raised));
    --risk: light-dark(#923c1d, #ffba92);
  }
  .product-page .site-shell { width: min(1240px, calc(100% - clamp(40px, 10vw, 144px))); }
  .product-page .site-header { background: var(--page); border-bottom: 0; }
  .product-page .site-header-inner { width: calc(100% - clamp(32px, 6vw, 96px)); min-height: 66px; justify-content: space-between; }
  .product-nav { display: flex; align-items: center; gap: clamp(11px, 2vw, 30px); }
  .product-nav a { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--ink); font-size: 15px; text-decoration: none; }
  .product-nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .product-nav .repo-link { font-weight: 600; }
  .product-page .site-footer { margin-top: 0; padding: 38px 0; }
  @media (max-width: 555px) {
    .product-page .site-shell { width: calc(100% - 36px); }
    .product-page .site-header-inner { width: calc(100% - 24px); min-height: 58px; padding-block: 5px; }
    .product-page .brand { gap: 6px; font-size: 18px; }
    .product-page .brand img { width: 26px; height: 26px; }
    .product-nav a { font-size: 14px; }
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .site-shell { width: calc(100% - 32px); }
    .site-header-inner { padding-block: 10px; }
    .footer-inner { grid-template-columns: 1fr; }
    .site-footer { margin-top: 56px; }
  }
  @media (max-width: 370px) {
    .site-header-inner { display: grid; grid-template-columns: 1fr auto; gap: 0 10px; }
    .site-header-inner .brand { grid-column: 1; grid-row: 1; }
    .site-header-inner [data-theme-control] { grid-column: 2; grid-row: 1; }
    .site-header-inner .product-nav { grid-column: 1 / -1; grid-row: 2; width: 100%; justify-content: space-between; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>
