  h2 { max-width: 520px; margin-top: 15px; font-size: clamp(30px,3.5vw,44px); line-height: 1.16; font-weight: 550; letter-spacing: -.05em; text-wrap: balance; }
  .video-heading > p { max-width: 440px; font-size: 15px; line-height: 1.7; color: var(--muted); text-wrap: pretty; }
  .video-frame { position: relative; }
  .video-player { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: 20px; background: var(--panel); }
  .video-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; padding: 14px 22px; border: 1px solid var(--line); border-radius: 999px; background: var(--ink); color: var(--on-ink); font-size: 14px; white-space: nowrap; }
  .video-play[hidden], .video-error[hidden] { display: none; }
  .video-play:hover { outline: 2px solid var(--green); outline-offset: 3px; }
  .video-error { margin-top: 16px; font-size: 14px; line-height: 1.6; color: var(--risk); }
  .video-player:focus-visible { outline: 3px solid var(--green); outline-offset: 5px; }
  .video-caption { margin-top: 16px; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .video-actions { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 8px; }
  .video-actions a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--green); font-size: 14px; text-underline-offset: 4px; }
  .video-summary { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.7; }
  .video-summary summary { width: fit-content; min-height: 44px; padding-block: 9px; cursor: pointer; font-weight: 550; }
  .video-summary p { max-width: 850px; margin-top: 12px; color: var(--muted); }
  @media (max-width: 760px) {
    .video-overview { padding-bottom: 40px; }
    .video-heading { grid-template-columns: 1fr; gap: 18px; }
    .video-player { border-radius: 12px; }
  }
</style>
