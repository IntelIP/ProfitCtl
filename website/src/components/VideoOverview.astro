<section class="site-shell video-overview" id="watch" aria-labelledby="video-heading">
  <header class="video-heading">
    <div><p class="eyebrow">A 30-second overview</p><h2 id="video-heading">Watch ProfitCtl in 30 seconds.</h2></div>
    <p>See why more revenue can still mean a lower operating margin. Follow one comparison, from the command to the decision.</p>
  </header>
  <div class="video-frame">
    <video
      id="overview-video"
      class="video-player"
      controls
      muted
      loop
      playsinline
      preload="none"
      src="/media/profitctl-demo-v2.mp4"
      width="1920"
      height="1080"
      poster="/images/profitctl-demo-v2.jpg"
      aria-label="ProfitCtl illustrative scenario comparison"
      aria-describedby="video-description"
    >
      <p>ProfitCtl compares revenue, operating margin, and cost per user across saved scenarios.</p>
    </video>
    <button class="video-toggle" type="button" hidden aria-controls="overview-video" aria-label="Play animation" title="Play animation">
      <svg class="pause-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 3h3v10H4zm5 0h3v10H9z" /></svg>
      <svg class="play-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="m5 3 8 5-8 5z" /></svg>
    </button>
  </div>
  <p class="video-error" role="status" hidden>The animation could not load. Use the play control to retry.</p>
  <p class="visually-hidden" id="video-description">In these illustrative saved scenarios, the steady-state example has $2,000 in revenue, a 95% operating margin, and $2.00 cost per user. The pilot has $6,500 in revenue, a 69% operating margin, and $12.40 cost per user. Recurring revenue is $2,000 in both. These are sample figures, not customer results.</p>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>("#overview-video");
  const button = document.querySelector<HTMLButtonElement>("#watch .video-toggle");
  const error = document.querySelector<HTMLParagraphElement>("#watch .video-error");
  if (video && button && error) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let wantsPlayback = !motion.matches;
    let visible = false;
    video.controls = false;
    video.muted = true;
    button.hidden = false;

    const updateControl = () => {
      const label = video.paused ? "Play animation" : "Pause animation";
      button.setAttribute("aria-label", label);
      button.title = label;
      button.dataset.playing = String(!video.paused);
    };
    const updatePlayback = () => {
      if (wantsPlayback && visible && !document.hidden) {
        void video.play().catch(updateControl);
      } else {
        video.pause();
      }
    };
    button.addEventListener("click", () => {
      wantsPlayback = video.paused;
      if (wantsPlayback && video.error) video.load();
      error.hidden = true;
      updatePlayback();
    });
    video.addEventListener("play", updateControl);
    video.addEventListener("pause", updateControl);
    video.addEventListener("error", () => {
      error.hidden = false;
      updateControl();
    });
    motion.addEventListener("change", () => {
      wantsPlayback = !motion.matches;
      updatePlayback();
    });
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updatePlayback();
    }, { threshold: 0.15 });
    observer.observe(video);
    document.addEventListener("visibilitychange", updatePlayback);
    updateControl();
  }
</script>

<style>
  .video-overview { padding-block: 20px 64px; }
  .video-heading { display: grid; grid-template-columns: 1fr .8fr; gap: 60px; align-items: end; margin-bottom: 28px; }
  .eyebrow { color: var(--muted); font-size: 11px; line-height: 1.6; font-weight: 600; letter-spacing: .055em; text-transform: uppercase; }
  h2 { max-width: 520px; margin-top: 15px; font-size: clamp(30px,3.5vw,44px); line-height: 1.16; font-weight: 550; letter-spacing: -.05em; text-wrap: balance; }
  .video-heading > p { max-width: 440px; font-size: 15px; line-height: 1.7; color: var(--muted); text-wrap: pretty; }
  .video-frame { position: relative; overflow: hidden; border-radius: 16px; background: var(--panel); }
  .video-player { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .video-toggle { position: absolute; right: 12px; bottom: 12px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: var(--panel); color: var(--ink); cursor: pointer; }
  .video-toggle[hidden], .video-error[hidden], .video-toggle[data-playing="true"] .play-icon, .video-toggle:not([data-playing="true"]) .pause-icon { display: none; }
  .video-toggle:hover { color: var(--green); }
  .video-toggle:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .video-error { margin-top: 16px; font-size: 14px; line-height: 1.6; color: var(--risk); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .video-overview { padding-bottom: 40px; }
    .video-heading { grid-template-columns: 1fr; gap: 18px; }
    .video-frame { border-radius: 12px; }
    .video-toggle { right: 8px; bottom: 8px; }
  }
</style>
