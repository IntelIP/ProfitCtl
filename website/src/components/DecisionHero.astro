---
import MarginFigure from "./MarginFigure.astro";
import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

const users = 1000;
const price = 20;
const volumes = [60, 120];
const cases = volumes.map(requests => ({ requests, ...calculateExample({ users, price, requests }) }));
---
<section class="decision-hero" aria-labelledby="decision-hero-title">
  <div class="hero-field">
    <div class="hero-copy">
      <h1 id="decision-hero-title">What does growth cost?</h1>
      <p>Test how AI usage, infrastructure and pricing change your margin. Run the numbers locally with ProfitCtl before you ship.</p>
      <div class="hero-actions">
        <a class="hero-cta" href="/agent/#self-host">Self-host the agent <span aria-hidden="true">→</span></a>
        <a class="agent-link" href="#demo">Try the CLI demo <span aria-hidden="true">↘</span></a>
      </div>
    </div>
    <MarginFigure {price} {users} {volumes} />
  </div>

  <section class="case-study site-shell" aria-labelledby="research-title">
    <header class="case-head">
      <div>
        <p class="case-label">An illustrative product decision</p>
        <h2 id="research-title">Can a {money(price)} plan afford research?</h2>
        <p class="case-basis">Model {users.toLocaleString("en-US")} paying users. Double the requests and see which side of the margin target you land on.</p>
      </div>
      <fieldset class="load-control">
        <legend>Monthly requests per user</legend>
        <div class="load-options">
          {cases.map(({ requests }, index) => (
            <label><input type="radio" name="research-load" value={requests} class:list={[{ "alternate-load": index > 0 }]} checked={index === 0} aria-controls={`load-${requests}`} /><span>{requests}</span></label>
          ))}
        </div>
      </fieldset>
    </header>
    {cases.map(({ requests, baseline, candidate, addedCost, passes }, index) => (
      <div class:list={["comparison", { alternate: index > 0 }]} id={`load-${requests}`}>
        <div class="cost"><p class="measure">Additional monthly cost</p><p class="cost-number">+{money(addedCost)}</p></div>
        <dl class="margin-list">
          {[{label: "Basic answers", value: baseline.margin}, {label: "With research", value: candidate.margin}].map(({label, value}) => (
            <div class="margin-row"><dt>{label} <span>· gross margin</span></dt><dd><span>{percent(value)}</span></dd></div>
          ))}
        </dl>
        <p class:list={["outcome", { shortfall: !passes }]}><span aria-hidden="true">{passes ? "↑" : "↓"}</span> {Math.abs(candidate.margin - exampleMarginTarget).toFixed(1)} points {passes ? "above" : "below"} the {exampleMarginTarget}% target with research.</p>
      </div>
    ))}
  </section>
</section>

<style>
  .hero-field {
    --hero-field: light-dark(#c4f77a, #103429);
    --hero-ink: light-dark(#122f23, #effadf);
    --hero-caption: light-dark(#223f29, #c9e8c7);
    --hero-button: light-dark(#183c2f, #c4f77a);
    --hero-button-text: light-dark(#f5ffeb, #102b20);
    margin: 0 clamp(5px, .65vw, 12px);
    overflow: hidden;
    border-radius: 15px;
    background: var(--hero-field);
    color: var(--hero-ink);
  }
  .hero-copy { padding: clamp(52px, 6.1vw, 100px) 22px 18px; text-align: center; }
  h1 { margin-inline: auto; font-size: clamp(58px, 7.2vw, 116px); line-height: .99; font-weight: 600; letter-spacing: -.026em; word-spacing: .065em; text-wrap: balance; }
  .hero-copy > p { max-width: 51ch; margin: 27px auto 0; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.45; letter-spacing: -.023em; text-wrap: pretty; }
  .hero-cta { display: inline-flex; align-items: center; justify-content: center; gap: 22px; min-height: 48px; margin-top: 26px; padding: 0 21px; border-radius: 999px; color: var(--hero-button-text); background: var(--hero-button); font-size: 15px; font-weight: 600; text-decoration: none; }
  .hero-cta:hover { background: light-dark(#295c45, #d9ffad); }
  .hero-cta:focus-visible { outline-color: var(--hero-ink); }
  .hero-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 4px 22px; margin-top: 26px; }
  .hero-actions .hero-cta { margin-top: 0; }
  .agent-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; font-weight: 600; text-underline-offset: 4px; }
  .hero-field > :global(figure) { margin-top: 5px; }
  .decision-hero :global(.active-slice.alternate), .comparison.alternate { display: none; }
  .decision-hero:has(.alternate-load:checked) :global(.active-slice), .decision-hero:has(.alternate-load:checked) .comparison { display: none; }
  .decision-hero:has(.alternate-load:checked) :global(.active-slice.alternate) { display: inline; }
  .decision-hero:has(.alternate-load:checked) .comparison.alternate { display: grid; }
  .case-study { padding-block: clamp(64px, 7vw, 118px) 0; }
  .case-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .case-label { margin: 0 0 15px; color: var(--green); font-size: 14px; font-weight: 600; }
  h2 { font-size: clamp(34px, 4.1vw, 65px); line-height: 1.05; font-weight: 550; letter-spacing: -.028em; word-spacing: .04em; text-wrap: balance; }
  .case-basis { max-width: 59ch; margin-top: 15px; color: var(--muted); font-size: 16px; line-height: 1.55; text-wrap: pretty; }
  .load-control { flex-shrink: 0; min-width: 0; margin: 0; padding: 0; border: 0; }
  .load-control legend { margin-bottom: 8px; padding: 0; font-size: 14px; font-weight: 550; }
  .load-options { display: flex; width: fit-content; border: 1px solid var(--line-strong); border-radius: 5px; }
  .load-options label { position: relative; display: flex; cursor: pointer; }
  .load-options input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .load-options label span { display: grid; place-items: center; min-width: 72px; min-height: 44px; border-radius: 3px; font-size: 16px; font-variant-numeric: tabular-nums; }
  .load-options input:checked + span { background: var(--ink); color: var(--on-ink); font-weight: 600; }
  .load-options input:focus-visible + span { outline: 3px solid var(--green); outline-offset: 3px; }
  .load-options input:hover:not(:checked) + span { background: var(--tint); }
  .comparison { display: grid; grid-template-columns: 1.1fr 2fr; gap: 22px 44px; margin-top: 31px; padding-top: 23px; border-top: 1px solid var(--line-strong); }
  .measure, .margin-row dt { color: var(--muted); font-size: 14px; line-height: 1.4; }
  .cost-number, .margin-row dd { margin-top: 8px; font-size: clamp(42px, 4.8vw, 78px); line-height: 1; font-weight: 500; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
  .cost-number { color: var(--green); }
  .margin-list { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; }
  .outcome { grid-column: 1 / -1; display: flex; align-items: center; gap: 7px; color: var(--green); font-size: 16px; line-height: 1.4; }
  .outcome span { font-weight: 650; }
  .shortfall { color: var(--risk); }
  @media (max-width: 760px) {
    .hero-copy { padding-top: 52px; }
    .case-head { display: grid; align-items: start; }
    .case-study { padding-top: 52px; }
    .comparison { gap: 18px; }
    .margin-row dt span { display: block; }
  }
  @media (max-width: 555px) {
    .hero-field { border-radius: 11px; }
    .hero-copy { padding: 48px 21px 18px; text-align: left; }
    h1 { margin: 0; max-width: 11ch; font-size: clamp(51px, 14.5vw, 76px); line-height: .96; }
    .hero-copy > p { margin: 20px 0 0; font-size: 17px; }
    .hero-cta { margin-top: 20px; }
    .case-head { gap: 22px; }
    .load-options label span { min-width: 63px; }
    .comparison { grid-template-columns: 1fr; margin-top: 22px; gap: 24px; }
    .margin-list { gap: 12px; }
    .margin-row dt span { display: inline; }
    .margin-row dd { font-size: 36px; }
    .cost-number { font-size: 57px; }
  }
  @media (forced-colors: active) {
    .hero-field, .hero-cta, .load-options { border: 1px solid CanvasText; }
    .load-options input:checked + span { outline: 2px solid Highlight; outline-offset: -3px; }
    .load-options input:focus-visible + span { outline-color: Highlight; outline-offset: 3px; }
  }
</style>
