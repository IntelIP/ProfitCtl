---
import MarginFigure from "./MarginFigure.astro";
const repoUrl = import.meta.env.PUBLIC_REPO_URL || "https://github.com/IntelIP/ProfitCtl";
import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

const users = 1000;
const price = 20;
const requests = 60;
const maxRequests = 160;
const example = calculateExample({ users, price, requests });
const gap = example.candidate.margin - exampleMarginTarget;
---
<section class="decision-hero band" aria-labelledby="decision-hero-title">
  <div class="site-shell">
    <div class="hero-copy">
      <h1 id="decision-hero-title">What does growth cost?</h1>
      <p>ProfitCTL is an open-source tool that models AI and infrastructure costs for teams building AI products. See how usage and pricing change your margin before you ship.</p>
      <div class="hero-actions">
        <a class="hero-cta" href="#demo">Try the CLI demo <span aria-hidden="true">↘</span></a>
        <a class="hero-link" href={repoUrl + "/blob/main/docs/INSTALL.md"} target="_blank" rel="noopener noreferrer"><span>Install guide</span><span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero-facts">Open source · Runs on your machine · No sign-up</p>
    </div>

    <section id="research-comparison" class="case-study" aria-labelledby="research-title" data-case-study data-users={users} data-price={price} data-state={example.passes ? "pass" : "risk"}>
      <div class="case-head">
        <p class="case-label">Illustrative scenario</p>
        <h2 id="research-title">Can a {money(price)} plan afford a research feature?</h2>
        <p class="case-basis">{users.toLocaleString("en-US")} subscribers pay {money(price)} a month. A research request costs more to serve than a basic answer. Raise usage to see where the margin falls below the {exampleMarginTarget}% target.</p>
        <div class="load-control">
          <div class="load-label"><label for="research-load">Monthly requests per user</label><output for="research-load" data-load-value>{requests}</output></div>
          <input id="research-load" type="range" min="30" max={maxRequests} step="5" value={requests} />
        </div>
        <div class="case-result" role="status" aria-live="polite" aria-atomic="true"><dl>
          <div class="result-main">
            <dt>Gross margin with research</dt>
            <dd><strong data-research-margin>{percent(example.candidate.margin)}</strong><span class="verdict-chip"><i aria-hidden="true" data-verdict-icon>{example.passes ? "✓" : "!"}</i><span data-verdict-text>{Math.abs(gap).toFixed(1)} points {example.passes ? "above" : "below"} target</span></span></dd>
          </div>
          <div>
            <dt>Added cost of research</dt>
            <dd><span data-added-cost>{money(example.addedCost)}</span> a month</dd>
          </div>
        </dl></div>
      </div>
      <MarginFigure users={users} price={price} requests={requests} maxRequests={maxRequests} />
    </section>
  </div>
</section>

<script>
  import { calculateExample, exampleMarginTarget, money, percent } from "../scripts/demo";

  const study = document.querySelector<HTMLElement>("[data-case-study]");
  const figure = study?.querySelector<HTMLElement>("[data-margin-figure]");
  const slider = study?.querySelector<HTMLInputElement>("#research-load");
  const plot = study?.querySelector<HTMLElement>("[data-plot]");
  if (study && figure && slider && plot) {
    const users = Number(study.dataset.users);
    const price = Number(study.dataset.price);
    const maxRequests = Number(figure.dataset.max);
    const text = (selector: string, value: string) => { study.querySelector<HTMLElement>(selector)!.textContent = value; };
    const render = () => {
      const requests = slider.valueAsNumber;
      const result = calculateExample({ users, price, requests });
      const gap = result.candidate.margin - exampleMarginTarget;
      figure.style.setProperty("--x", `${requests / maxRequests * 100}%`);
      figure.dataset.side = requests > maxRequests * 0.75 ? "left" : "right";
      figure.style.setProperty("--basic", `${100 - result.baseline.margin}%`);
      figure.style.setProperty("--research", `${100 - result.candidate.margin}%`);
      study.dataset.state = result.passes ? "pass" : "risk";
      text("[data-load-value]", String(requests));
      text("[data-basic-value]", percent(result.baseline.margin));
      text("[data-research-value]", percent(result.candidate.margin));
      text("[data-research-margin]", percent(result.candidate.margin));
      text("[data-verdict-icon]", result.passes ? "✓" : "!");
      text("[data-verdict-text]", `${Math.abs(gap).toFixed(1)} points ${result.passes ? "above" : "below"} target`);
      text("[data-added-cost]", money(result.addedCost));
    };
    slider.addEventListener("input", render);
    // Dragging on the chart moves the same control, so the slider stays the single source of the value.
    const drag = (event: PointerEvent) => {
      const bounds = plot.getBoundingClientRect();
      const step = Number(slider.step);
      const raw = (event.clientX - bounds.left) / bounds.width * maxRequests;
      slider.value = String(Math.round(raw / step) * step);
      render();
    };
    plot.addEventListener("pointerdown", event => { plot.setPointerCapture(event.pointerId); drag(event); });
    plot.addEventListener("pointermove", event => { if (plot.hasPointerCapture(event.pointerId)) drag(event); });
    render();
  }
</script>

<style>
  .decision-hero.band { --hero-ink: light-dark(var(--icon-ink), var(--dark-text)); margin-top: var(--band-inset); padding-top: calc(var(--section-y) * .45); background: light-dark(var(--icon-sage), var(--dark-surface)); color: var(--hero-ink); }
  h1 { font-size: var(--text-h1); line-height: 1.04; font-weight: 600; letter-spacing: -.03em; text-wrap: balance; }
  .hero-copy > .hero-facts { margin-top: 16px; font-size: var(--text-small); font-weight: 600; opacity: .8; }
  .hero-copy > p { max-width: 52ch; margin-top: 20px; font-size: var(--text-lede); line-height: 1.5; text-wrap: pretty; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 24px; margin-top: 24px; }
  .hero-cta, .hero-link { display: inline-flex; align-items: center; min-height: 48px; font-size: var(--text-body); font-weight: 600; text-decoration: none; transition: background-color .15s ease; }
  .hero-cta { justify-content: center; gap: 16px; padding: 0 24px; border-radius: 999px; color: light-dark(#f5f5ee, var(--icon-ink)); background: light-dark(var(--icon-ink), var(--icon-sage)); }
  .hero-cta:hover { background: light-dark(#3a4136, #c3ccc4); }
  .hero-cta:focus-visible, .hero-link:focus-visible { outline-color: var(--hero-ink); }
  .hero-link { gap: 8px; }
  .hero-link span:first-child { text-decoration: underline; text-underline-offset: .25em; }
  .case-study {
    --case-panel: light-dark(#fbfdf6, var(--dark-raised));
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
    margin-top: clamp(32px, 3.5vw, 48px);
    padding: clamp(22px, 2.8vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--case-panel);
    color: var(--ink);
  }
  .case-label { color: var(--muted); font-size: var(--text-small); font-weight: 600; }
  h2 { margin-top: 10px; font-size: var(--text-h3); line-height: 1.15; font-weight: 600; letter-spacing: -.02em; text-wrap: balance; }
  .case-basis { max-width: 44ch; margin-top: 12px; color: var(--muted); font-size: var(--text-body); line-height: 1.5; text-wrap: pretty; }
  .load-control { margin-top: 28px; }
  .load-label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: var(--text-small); font-weight: 600; }
  .load-label output { font-size: var(--text-h3); line-height: 1; font-variant-numeric: tabular-nums; }
  .load-control input { display: block; width: 100%; min-height: 44px; margin: 8px 0 0; accent-color: var(--series-research); cursor: pointer; }
  .load-control input:focus-visible { outline-offset: 0; border-radius: var(--radius); }
  .case-result { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line); }
  .case-result dl { display: grid; gap: 16px; margin: 0; }
  .case-result dt { color: var(--muted); font-size: var(--text-small); }
  .case-result dd { margin: 4px 0 0; font-size: var(--text-body); line-height: 1.4; font-variant-numeric: tabular-nums; }
  .result-main dd { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; }
  .result-main strong { font-size: clamp(34px, 3.4vw, 46px); line-height: 1; font-weight: 600; letter-spacing: -.03em; }
  .verdict-chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; background: light-dark(#e4e9e3, #262d2a); font-size: var(--text-small); font-weight: 600; }
  .verdict-chip i { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--series-research); color: var(--case-panel); font-style: normal; font-size: 13px; }
  [data-state="risk"] .verdict-chip { background: light-dark(#fbe6dc, #3a231a); }
  [data-state="risk"] .verdict-chip i { background: var(--risk); }
  @media (max-width: 820px) {
    /* Stack as question, chart, slider, result so the control stays next to what it changes. */
    .case-study { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .case-head { display: contents; }
    .case-study :global(.margin-figure) { order: 1; margin-top: 24px; }
    .load-control { order: 2; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
    .case-result { order: 3; }
    .case-basis { max-width: 56ch; }
  }
  @media (max-width: 555px) {
    .case-study { padding: 22px 16px 24px; }
  }
  @media (forced-colors: active) {
    .decision-hero, .hero-cta, .case-study, .verdict-chip { border: 1px solid CanvasText; }
  }
</style>
